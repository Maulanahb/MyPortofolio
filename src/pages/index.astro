---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HyperFramesFlow from '../components/HyperFramesFlow.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import ExperienceEducation from '../components/ExperienceEducation.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Modal from '../components/Modal.astro';
import CommandPalette from '../components/CommandPalette.astro';
---

<Layout title="Maulana · Portofolio Junior System Analyst & Web/Mobile Developer">
  <Header />

  <main id="beranda">
    <div class="bg-opening-stage">
      <div class="ambient-mesh" aria-hidden="true"></div>
      <Hero />
      <HyperFramesFlow />
    </div>
    <hr class="section-rule" />
    <About />
    <Projects />
    <ExperienceEducation />
    <Contact />
  </main>

  <Footer />
  <Modal />
  <CommandPalette />
</Layout>

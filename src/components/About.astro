---
import { SITE_CONFIG, SKILL_GROUPS } from '../data/projects';
---

<section class="section" id="tentang" aria-labelledby="about-title">
  <div class="shell">
    <div class="section-head">
    <div>
      <h2 class="section-title display" id="about-title">Tentang <span class="title-highlight">Saya</span></h2>
      <p class="section-subtitle">Profil akademik, keahlian teknis, dan fokus peran di sistem informasi.</p>
    </div>
  </div>

  <div class="about-grid">
    <!-- Left Summary Card -->
    <div class="about-badge" data-spotlight>
      <div class="big-quote display">Analisis sistem sampai rilis aplikasi.</div>

      <div class="about-meta-list">
        <div class="about-meta-item">
          <span class="meta-label mono">Pendidikan</span>
          <strong>{SITE_CONFIG.program} · {SITE_CONFIG.campus}</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">Semester</span>
          <strong>{SITE_CONFIG.semester} · Angkatan 2024</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">Fokus</span>
          <strong>{SITE_CONFIG.role}</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">Stack Utama</span>
          <strong>Laravel, React, Flutter, PostgreSQL</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">GitHub</span>
          <strong>github.com/{SITE_CONFIG.githubHandle}</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">Status</span>
          <strong>{SITE_CONFIG.availability}</strong>
        </div>
      </div>
    </div>

    <!-- Right Narrative -->
    <div class="about-copy" data-spotlight>
      <p>
        Saya {SITE_CONFIG.fullName}, mahasiswa semester 5 {SITE_CONFIG.program} di Politeknik Negeri Malang. Saya terbiasa memulai proyek dari analisis kebutuhan, menulis PRD, merancang ERD database, hingga mengimplementasikan aplikasinya.
      </p>

      <p>
        Di pengembangan aplikasi, saya menggunakan Laravel, React, TypeScript, dan Flutter dengan PostgreSQL serta MySQL. Saat ini berstatus Open to Work untuk kesempatan magang, PKL, atau peran junior developer.
      </p>

      <div class="about-interest-pills" aria-label="Fokus bidang yang diminati">
        {SITE_CONFIG.interests.map(item => (
          <span class="interest-pill mono">{item}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Skills Section -->
  <div class="skills-section-wrap" id="keahlian" aria-labelledby="skills-title">
    <div class="skills-head">
      <div>
        <h3 class="skills-main-title display" id="skills-title">Tech Stack &amp; Keahlian</h3>
        <p class="section-subtitle skills-sub">Klik salah satu teknologi untuk melihat studi kasus proyek yang menggunakannya.</p>
      </div>
    </div>

    <!-- Interactive Skill-to-Project Bridge Banner -->
    <div class="skill-bridge-bar" id="skill-bridge-bar" hidden>
      <div class="skill-bridge-inner">
        <div class="skill-bridge-info">
          <strong id="skill-bridge-title" class="display">Stack</strong>
          <span id="skill-bridge-summary" class="skill-bridge-summary"></span>
        </div>
        <div class="skill-bridge-actions" id="skill-bridge-actions">
          <div class="skill-bridge-chips" id="skill-bridge-projects"></div>
          <button type="button" class="button tiny primary" id="skill-bridge-filter-btn" hidden>
            Filter Proyek ↓
          </button>
          <button type="button" class="skill-bridge-close mono" id="skill-bridge-clear" aria-label="Tutup detail stack">
            ×
          </button>
        </div>
      </div>
    </div>

    <div class="skill-groups si-skill-grid">
      {SKILL_GROUPS.map(group => (
        <article class={`skill-box ${group.proofs ? 'skill-card-wide' : ''}`} data-spotlight>
          <div class="skill-card-top">
            <h4 class="display">{group.title}</h4>
            <span class="skill-subtitle">{group.subtitle}</span>
          </div>

          {group.icons && group.icons.length > 0 && (
            <div class="skill-icon-grid" role="list" aria-label={group.title}>
              {group.icons.map(icon => (
                <div class="skill-chip-item" role="listitem">
                  <button
                    type="button"
                    class="skill-chip"
                    data-skill-id={icon.iconId}
                    data-skill-name={icon.name}
                    aria-pressed="false"
                  >
                    <svg class="skill-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <use href={`#tech-${icon.iconId}`} />
                    </svg>
                    <span class="skill-chip-name">{icon.name}</span>
                  </button>
                </div>
              ))}
            </div>
          )}

          {group.pills && group.pills.length > 0 && (
            <div class="skill-pill-row">
              {group.pills.map(pill => (
                <span class="skill-pill mono">{pill}</span>
              ))}
            </div>
          )}

          {group.proofs && group.proofs.length > 0 && (
            <div class="soft-skill-proofs">
              <div class="proof-heading mono">PENERAPAN PADA PROYEK:</div>
              <div class="proof-grid">
                {group.proofs.map(item => (
                  <div class="proof-item">
                    <strong class="mono">{item.skill}</strong>
                    <p>{item.proof}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
  </div>
</section>

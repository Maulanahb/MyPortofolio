---
import { SITE_CONFIG, SKILL_GROUPS } from '../data/projects';
---

<section class="section shell" id="tentang" aria-labelledby="about-title">
  <div class="chapter-kicker mono">✦ CHAPTER 01 <span>TENTANG SAYA &amp; KEAHLIAN SI</span></div>

  <div class="about-grid">
    <!-- Left Comic Badge & Quick SI Profile Card -->
    <div class="about-badge">
      <div>
        <span class="about-starburst display">SI!</span>
        <div class="eyebrow mono">PROFIL SINGKAT / IDENTITY</div>
        <div class="big-quote display">PROSES BISNIS JELAS. SISTEM JADI TANGGUH.</div>
      </div>

      <div class="about-meta-list">
        <div class="about-meta-item">
          <span class="meta-label mono">KAMPUS &amp; PRODI</span>
          <strong>{SITE_CONFIG.program} — {SITE_CONFIG.campus}</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">STATUS AKADEMIK</span>
          <strong>{SITE_CONFIG.semester} · Angkatan 2024</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">IPK (SEMESTER 1–4)</span>
          <strong>{SITE_CONFIG.gpa}</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">REPOSITORI PUBLIK</span>
          <strong>{SITE_CONFIG.githubRepos} (github.com/{SITE_CONFIG.githubHandle})</strong>
        </div>
        <div class="about-meta-item highlight">
          <span class="meta-label mono">SEDANG MENCARI</span>
          <strong>{SITE_CONFIG.internshipTarget}</strong>
        </div>
      </div>

      <span class="small-note mono">{SITE_CONFIG.fullName.toUpperCase()} · NIM {SITE_CONFIG.nim}</span>
    </div>

    <!-- Right Narrative: 3 Paragraphs (Professional & Personal) -->
    <div class="about-copy">
      <div class="eyebrow mono">01 / Tentang saya</div>
      <h2 class="section-title display" id="about-title">ANALISIS SISTEM<br/><span class="title-highlight">&amp; REKAYASA WEB/MOBILE.</span></h2>

      <p>
        Saya <strong>{SITE_CONFIG.fullName}</strong>, mahasiswa semester 5 <strong>{SITE_CONFIG.program}</strong> di Politeknik Negeri Malang. Sejak 2024 saya menyimpan hampir semua tugas dan proyek di GitHub, jadi apa yang saya tulis di sini bisa dicek langsung kodenya.
      </p>

      <p>
        Saya paling sering bekerja di dua sisi. Pertama menulis kebutuhan sistem: siapa penggunanya, apa saja hak aksesnya, dan seperti apa databasenya. Setelah itu saya ikut membangunnya, biasanya dengan <strong>Laravel</strong> atau <strong>React</strong> untuk web dan <strong>Flutter</strong> untuk mobile.
      </p>

      <p>
        Sekarang saya mencari tempat <strong>magang atau PKL</strong> sebagai <strong>System Analyst, Full-Stack Web Developer, atau Mobile Developer</strong>. Saya ingin belajar bagaimana tim sungguhan menulis kebutuhan, mereview kode, dan merilis produk.
      </p>

      <div class="about-interest-pills" aria-label="Fokus bidang yang diminati">
        {SITE_CONFIG.interests.map(item => (
          <span class="interest-pill mono">✦ {item}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Sub-section 3: Skills Lintas Bidang Sistem Informasi -->
  <div class="skills-section-wrap" id="keahlian" aria-labelledby="skills-title">
    <div class="skills-head">
      <div>
        <div class="eyebrow mono">02 / Keahlian lintas bidang SI</div>
        <h3 class="skills-main-title display" id="skills-title">KOMBINASI TEKNIS, ANALISIS SISTEM &amp; EKSEKUSI TIM.</h3>
      </div>
      <p class="skills-subcopy">
        Di Sistem Informasi, menulis kode saja tidak cukup. Saya juga perlu bisa memetakan proses bisnis, memakai tools tim, dan menjelaskan pekerjaan saya ke orang lain.
      </p>
    </div>

    <div class="skill-groups si-skill-grid">
      {SKILL_GROUPS.map(group => (
        <article class={`skill-box comic-skill-card ${group.proofs ? 'skill-card-wide' : ''}`}>
          <div class="skill-card-top">
            <span class="skill-code mono">{group.code}</span>
            <h4 class="display">{group.title}</h4>
            <span class="skill-subtitle mono">{group.subtitle}</span>
          </div>

          <p class="skill-desc">{group.items}</p>

          {group.icons && group.icons.length > 0 && (
            <div class="skill-icon-grid" role="list" aria-label={`Daftar icon ${group.title}`}>
              {group.icons.map(icon => (
                <div
                  class="skill-icon-tile"
                  role="listitem"
                  aria-label={icon.name}
                  data-tooltip={icon.name}
                  tabindex="0"
                >
                  <svg class="skill-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <use href={`#tech-${icon.iconId}`} />
                  </svg>
                </div>
              ))}
            </div>
          )}

          {group.pills && group.pills.length > 0 && (
            <div class="skill-pill-row">
              {group.pills.map(pill => (
                <span class="skill-pill mono">{pill}</span>
              ))}
            </div>
          )}

          {group.proofs && group.proofs.length > 0 && (
            <div class="soft-skill-proofs">
              <div class="proof-heading mono">BUKTI KONKRET PADA PROYEK:</div>
              <div class="proof-grid">
                {group.proofs.map(item => (
                  <div class="proof-item">
                    <strong class="mono">{item.skill}</strong>
                    <p>{item.proof}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

---
import { SITE_CONFIG, SKILL_GROUPS } from '../data/projects';
---

<section class="section shell" id="tentang" aria-labelledby="about-title">
  <div class="chapter-kicker mono">✦ CHAPTER 01 <span>TENTANG SAYA &amp; KEAHLIAN</span></div>

  <div class="about-grid">
    <!-- Left Comic Badge & Quick Profile Card -->
    <div class="about-badge">
      <div>
        <div class="eyebrow mono">PROFIL SINGKAT</div>
        <div class="big-quote display">PERANCANGAN SISTEM &amp; PENGEMBANGAN APLIKASI.</div>
      </div>

      <div class="about-meta-list">
        <div class="about-meta-item">
          <span class="meta-label mono">KAMPUS &amp; PRODI</span>
          <strong>{SITE_CONFIG.program} · {SITE_CONFIG.campus}</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">STATUS AKADEMIK</span>
          <strong>{SITE_CONFIG.semester} · Angkatan 2024</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">MINAT POSISI</span>
          <strong>Junior System Analyst · Junior Web &amp; Mobile Dev</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">STACK TEKNOLOGI UTAMA</span>
          <strong>Laravel · React · Flutter · PostgreSQL</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">REPOSITORI PUBLIK</span>
          <strong>{SITE_CONFIG.githubRepos} (github.com/{SITE_CONFIG.githubHandle})</strong>
        </div>
        <div class="about-meta-item">
          <span class="meta-label mono">KETERSEDIAAN</span>
          <strong>Siap ditempatkan On-site maupun Remote</strong>
        </div>
      </div>
    </div>

    <!-- Right Narrative: 3 Paragraphs (Professional & Personal) -->
    <div class="about-copy">
      <div class="eyebrow mono">✦ PROFIL &amp; LATAR BELAKANG</div>
      <h2 class="section-title display" id="about-title">LATAR BELAKANG<br/><span class="title-highlight">&amp; KOMPETENSI.</span></h2>

      <p>
        Saya {SITE_CONFIG.fullName}, mahasiswa semester 5 {SITE_CONFIG.program} di Politeknik Negeri Malang. Saya memiliki ketertarikan besar pada dunia teknologi dan bagaimana perangkat lunak memecahkan masalah nyata, mulai dari memahami kebutuhan pengguna hingga menjadikannya aplikasi yang fungsional dan nyaman digunakan.
      </p>

      <p>
        Secara teknis, saya terbiasa mengembangkan aplikasi web berbasis Laravel dan React serta aplikasi mobile dengan Flutter. Didorong oleh rasa ingin tahu yang tinggi, saya selalu terbuka dan bersemangat mempelajari hal-hal baru, baik itu tools baru, bahasa pemrograman lain, maupun standar kerja di tim industri.
      </p>

      <p>
        Saat ini saya aktif mencari peluang magang, PKL, maupun kesempatan kerja tingkat junior pada peran Junior System Analyst, Full-Stack Web Developer, atau Mobile Developer. Sebagai talenta junior, saya siap beradaptasi dengan cepat, berkolaborasi aktif dengan tim, dan terus belajar hal baru untuk memberikan kontribusi nyata.
      </p>

      <div class="about-interest-pills" aria-label="Fokus bidang yang diminati">
        {SITE_CONFIG.interests.map(item => (
          <span class="interest-pill mono">✦ {item}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Sub-section 3: Skills Lintas Bidang Sistem Informasi -->
  <div class="skills-section-wrap" id="keahlian" aria-labelledby="skills-title">
    <div class="skills-head">
      <div>
        <div class="eyebrow mono">✦ TOOLKIT &amp; TEKNOLOGI</div>
        <h3 class="skills-main-title display" id="skills-title">KEAHLIAN TEKNIS &amp; BAHASA PEMROGRAMAN.</h3>
      </div>
    </div>

    <div class="skill-groups si-skill-grid">
      {SKILL_GROUPS.map(group => (
        <article class={`skill-box comic-skill-card ${group.proofs ? 'skill-card-wide' : ''}`}>
          <div class="skill-card-top">
            <span class="skill-code mono">{group.code}</span>
            <h4 class="display">{group.title}</h4>
            <span class="skill-subtitle mono">{group.subtitle}</span>
          </div>

          <p class="skill-desc">{group.items}</p>

          {group.icons && group.icons.length > 0 && (
            <div class="skill-icon-grid" role="list" aria-label={`Daftar icon ${group.title}`}>
              {group.icons.map(icon => (
                <div
                  class="skill-icon-tile"
                  role="listitem"
                  aria-label={icon.name}
                  data-tooltip={icon.name}
                  tabindex="0"
                >
                  <svg class="skill-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <use href={`#tech-${icon.iconId}`} />
                  </svg>
                </div>
              ))}
            </div>
          )}

          {group.pills && group.pills.length > 0 && (
            <div class="skill-pill-row">
              {group.pills.map(pill => (
                <span class="skill-pill mono">{pill}</span>
              ))}
            </div>
          )}

          {group.proofs && group.proofs.length > 0 && (
            <div class="soft-skill-proofs">
              <div class="proof-heading mono">PENERAPAN PADA PROYEK:</div>
              <div class="proof-grid">
                {group.proofs.map(item => (
                  <div class="proof-item">
                    <strong class="mono">{item.skill}</strong>
                    <p>{item.proof}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

---
import { SITE_CONFIG } from '../data/projects';
---

<section class="contact shell" id="kontak" aria-labelledby="contact-title">
  <div class="chapter-kicker mono">✦ CHAPTER 05 <span>KONTAK, UNDUH CV &amp; KOLABORASI</span></div>

  <div class="contact-box">
    <span class="contact-sfx display" aria-hidden="true">TO BE CONTINUED...</span>

    <div class="contact-layout-grid">
      <!-- Kolom Kiri: Info Kontak Langsung & Link CV -->
      <div class="contact-info-col">
        <div class="eyebrow mono">✦ HUBUNGI &amp; DISKUSI</div>
        <h2 id="contact-title" class="contact-title display">INFORMASI KONTAK<br/>&amp; KETERSEDIAAN.</h2>
        <p class="contact-lead">
          Terbuka untuk magang atau PKL dan kolaborasi proyek.
        </p>

        <div class="contact-channels" aria-label="Kanal kontak langsung">
          <a class="channel-card" href={`mailto:${SITE_CONFIG.email}`}>
            <span class="channel-label mono">EMAIL</span>
            <strong>{SITE_CONFIG.email}</strong>
          </a>
          <a class="channel-card" href={SITE_CONFIG.linkedin} target="_blank" rel="noopener noreferrer">
            <span class="channel-label mono">LINKEDIN</span>
            <strong>linkedin.com/in/maulanahb ↗</strong>
          </a>
          <a class="channel-card" href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer">
            <span class="channel-label mono">GITHUB PROFILE</span>
            <strong>github.com/Maulanahb ↗</strong>
          </a>
          <a class="channel-card" href={`${SITE_CONFIG.github}?tab=repositories`} target="_blank" rel="noopener noreferrer">
            <span class="channel-label mono">REPOSITORI PUBLIK</span>
            <strong>{SITE_CONFIG.githubRepos} ↗</strong>
          </a>
        </div>

        <div class="contact-buttons">
          <a class="button dark action-manga contact-btn-primary" href="/CV-Maulana-Ahmad-Bukhori.pdf" download="CV-Maulana-Ahmad-Bukhori.pdf" target="_blank">
            <svg class="btn-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/>
            </svg>
            <span>UNDUH CV (PDF)</span> <span class="arrow">↓</span>
          </a>
          <button type="button" class="button contact-btn-icon" id="email-button" aria-label="Kirim Email" title="Kirim Email">
            <svg class="btn-svg" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span class="btn-label">Kirim Email ↗</span>
          </button>
          <button type="button" class="button contact-btn-icon" id="github-button" aria-label="Buka Profil GitHub" title="Buka Profil GitHub">
            <svg class="btn-svg" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span class="btn-label">GitHub ↗</span>
          </button>
        </div>
      </div>

      <!-- Kolom Kanan: Form Kontak Sederhana -->
      <div class="contact-form-panel comic-panel">
        <div class="form-panel-head mono">
          <span>FORM PESAN CEPAT</span>
          <span>DIRECT MESSAGE</span>
        </div>

        <form id="contact-form" class="contact-form" novalidate>
          <div class="form-field">
            <label for="contact-name" class="mono">NAMA LENGKAP ATAU INSTANSI</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              placeholder="Contoh: Budi, HR atau Tech Lead PT ..."
              required
            />
          </div>

          <div class="form-row-2">
            <div class="form-field">
              <label for="contact-email" class="mono">EMAIL BALASAN</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="nama@perusahaan.com"
                required
              />
            </div>

            <div class="form-field">
              <label for="contact-subject" class="mono">KEPERLUAN</label>
              <select id="contact-subject" name="subject">
                <option value="Tawaran Magang atau PKL">Tawaran Magang atau PKL</option>
                <option value="Kolaborasi Proyek Web & Mobile">Kolaborasi Proyek Web & Mobile</option>
                <option value="Diskusi Analisis & Desain Sistem">Diskusi Analisis Sistem</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="contact-message" class="mono">PESAN SINGKAT</label>
            <textarea
              id="contact-message"
              name="message"
              rows="3"
              placeholder="Tulis pesan atau detail singkat kebutuhan Anda..."
              required
            ></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="button dark" style="width: 100%;">
              KIRIM PESAN SEKARANG <span class="arrow">↗</span>
            </button>
          </div>
          <p id="contact-form-status" class="form-status mono" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

---
// Ambient Animated Manga & Tech Floating Background Elements
---

<div class="bg-floating-canvas" aria-hidden="true">
  {/* 1. Code Brackets { } - Top Left */}
  <div class="float-item float-code-brackets" style="--d: 0s; --dur: 9s;">
    <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 18a4 4 0 0 0-4-4V6a4 4 0 0 0-4-4"/>
      <path d="M8 6a4 4 0 0 0 4 4v8a4 4 0 0 0 4 4"/>
    </svg>
  </div>

  {/* 2. Manga Sparkle ✦ (Large) - Top Right */}
  <div class="float-item float-sparkle-lg" style="--d: 1.5s; --dur: 11s;">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="currentColor">
      <path d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"/>
    </svg>
  </div>

  {/* 3. Comic Crosshair ✛ - Upper Right */}
  <div class="float-item float-crosshair" style="--d: 2s; --dur: 14s;">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="9"/>
      <line x1="12" y1="3" x2="12" y2="7"/>
      <line x1="12" y1="17" x2="12" y2="21"/>
      <line x1="3" y1="12" x2="7" y2="12"/>
      <line x1="17" y1="12" x2="21" y2="12"/>
      <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
    </svg>
  </div>

  {/* 4. Isometric Wireframe Cube - Upper Left */}
  <div class="float-item float-cube" style="--d: 3s; --dur: 13s;">
    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M12 2 L21 7 L21 17 L12 22 L3 17 L3 7 Z"/>
      <line x1="12" y1="2" x2="12" y2="12"/>
      <line x1="12" y1="12" x2="21" y2="7"/>
      <line x1="12" y1="12" x2="3" y2="7"/>
    </svg>
  </div>

  {/* 5. Terminal Prompt >_ - Mid Left */}
  <div class="float-item float-terminal" style="--d: 0.8s; --dur: 10s;">
    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 17 10 11 4 5"/>
      <line x1="12" y1="19" x2="20" y2="19"/>
    </svg>
  </div>

  {/* 6. Code Tag < / > - Mid Left / Center */}
  <div class="float-item float-tag" style="--d: 4s; --dur: 12s;">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="16 18 22 12 16 6"/>
      <polyline points="8 6 2 12 8 18"/>
    </svg>
  </div>

  {/* 7. Action Speedline Burst - Mid Right */}
  <div class="float-item float-speedlines" style="--d: 2.2s; --dur: 8s;">
    <svg viewBox="0 0 32 32" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="2" y1="16" x2="14" y2="16"/>
      <line x1="6" y1="8" x2="15" y2="12"/>
      <line x1="6" y1="24" x2="15" y2="20"/>
      <line x1="16" y1="2" x2="16" y2="10"/>
      <line x1="16" y1="22" x2="16" y2="30"/>
      <line x1="26" y1="8" x2="17" y2="12"/>
      <line x1="26" y1="24" x2="17" y2="20"/>
      <line x1="30" y1="16" x2="18" y2="16"/>
    </svg>
  </div>

  {/* 8. Git Branch Nodes - Lower Left */}
  <div class="float-item float-git" style="--d: 1s; --dur: 11.5s;">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="6" y1="3" x2="6" y2="15"/>
      <circle cx="18" cy="6" r="3" fill="currentColor"/>
      <circle cx="6" cy="18" r="3" fill="currentColor"/>
      <path d="M18 9a9 9 0 0 1-9 9"/>
    </svg>
  </div>

  {/* 9. Circuit Chip Node - Lower Right */}
  <div class="float-item float-chip" style="--d: 3.5s; --dur: 15s;">
    <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8">
      <rect x="5" y="5" width="14" height="14" rx="2"/>
      <line x1="9" y1="1" x2="9" y2="5"/>
      <line x1="15" y1="1" x2="15" y2="5"/>
      <line x1="9" y1="19" x2="9" y2="23"/>
      <line x1="15" y1="19" x2="15" y2="23"/>
      <line x1="1" y1="9" x2="5" y2="9"/>
      <line x1="1" y1="15" x2="5" y2="15"/>
      <line x1="19" y1="9" x2="23" y2="9"/>
      <line x1="19" y1="15" x2="23" y2="15"/>
      <circle cx="12" cy="12" r="2.5" fill="currentColor"/>
    </svg>
  </div>

  {/* 10. Comic Dialogue / Halftone Dots - Bottom Center */}
  <div class="float-item float-dots" style="--d: 2.8s; --dur: 9.5s;">
    <svg viewBox="0 0 28 28" width="30" height="30" fill="currentColor">
      <circle cx="5" cy="5" r="2"/>
      <circle cx="14" cy="5" r="2"/>
      <circle cx="23" cy="5" r="2"/>
      <circle cx="5" cy="14" r="2"/>
      <circle cx="14" cy="14" r="3"/>
      <circle cx="23" cy="14" r="2"/>
      <circle cx="5" cy="23" r="2"/>
      <circle cx="14" cy="23" r="2"/>
      <circle cx="23" cy="23" r="2"/>
    </svg>
  </div>

  {/* 11. Manga Sparkle ✦ (Medium) - Bottom Right */}
  <div class="float-item float-sparkle-sm" style="--d: 0.5s; --dur: 8.5s;">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
      <path d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"/>
    </svg>
  </div>

  {/* 12. Comic Star Burst - Bottom Left */}
  <div class="float-item float-starburst" style="--d: 4.5s; --dur: 13s;">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>
  </div>
</div>


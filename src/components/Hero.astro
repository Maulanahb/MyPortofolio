---
import { SITE_CONFIG, CERTIFICATIONS } from '../data/projects';

const ROLE_LENSES = [
  {
    id: 'analyst',
    label: 'System Analyst',
    summary: 'Project Charter, PRD terstruktur, pemodelan ERD, dan pembagian hak akses RBAC sebelum mulai ngoding.',
    proofs: [
      { id: 'cuciin', name: 'CUCI.IN · PRD & ERD' },
      { id: 'aiaas', name: 'AIAAS · Kontrak JSON' }
    ]
  },
  {
    id: 'fullstack',
    label: 'Full-Stack Web',
    summary: 'Aplikasi Laravel, React TypeScript, API proxy server-side, optimasi Materialized View PostgreSQL & PHPUnit CI.',
    proofs: [
      { id: 'bawanghub', name: 'BawangHub · React PWA' },
      { id: 'ivss', name: 'Portal IVSS · PostgreSQL' }
    ]
  },
  {
    id: 'mobile',
    label: 'Mobile & AI',
    summary: 'Aplikasi mobile Flutter dengan Riverpod, Midtrans Snap gateway, dan parser natural language berbasis Gemini API.',
    proofs: [
      { id: 'lapangku', name: 'Lapangku · Flutter' },
      { id: 'aiaas', name: 'AIAAS · Gemini 2.5 Flash' }
    ]
  }
];
const fullNameWords = SITE_CONFIG.fullName.trim().split(/\s+/);
const roleWords = SITE_CONFIG.role.trim().split(/\s+/);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="shell">
    <div class="hero-grid">
    <!-- Primary profile on the open canvas -->
    <div class="hero-main-panel">
      <div class="hero-lead-content">
        <div class="hero-status-row" data-enter="1">
          <span class="status-pill rb-shiny-pill">
            <span class="status-dot" aria-hidden="true"></span>
            <span>{SITE_CONFIG.availability}</span>
          </span>
        </div>

        <h1 class="hero-title display" id="hero-title">
          {fullNameWords.map((word, idx) => (
            <>
              <span class="rb-blur-word" style={`--rb-word-i: ${idx};`}>{word}</span>
              {idx < fullNameWords.length - 1 ? ' ' : ''}
            </>
          ))}
          <span class="hero-name">
            {roleWords.map((word, idx) => (
              <>
                <span class="rb-blur-word" style={`--rb-word-i: ${fullNameWords.length + idx};`}>{word}</span>
                {idx < roleWords.length - 1 ? ' ' : ''}
              </>
            ))}
          </span>
        </h1>

        <p class="hero-desc" data-enter="3">
          Mahasiswa D-IV Sistem Informasi Bisnis Polinema: analisis sistem, web, mobile, dan database.
        </p>

        <div class="hero-actions" data-enter="3">
          <a class="button primary hero-btn-primary" href="#pekerjaan" data-magnet data-spark>
            <svg class="btn-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/>
            </svg>
            <span>Lihat Proyek</span>
          </a>
          <a class="button hero-btn-icon" href={SITE_CONFIG.cvUrl} download="CV-Maulana-Ahmad-Bukhori.pdf" aria-label="Unduh CV (PDF)" title="Unduh CV (PDF)" data-magnet data-spark>
            <svg class="btn-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/>
            </svg>
            <span class="btn-label">Unduh CV</span>
          </a>
          <a class="button hero-btn-icon" href="#kontak" aria-label="Kontak" title="Kontak" data-magnet data-spark>
            <svg class="btn-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span class="btn-label">Kontak</span>
          </a>
        </div>
      </div>

      <!-- Interactive role and project evidence -->
      <div class="hero-role-dock" data-enter="4">
        <div class="hero-role-head">
          <div class="hero-role-tabs rb-true-focus-group" data-true-focus role="tablist" focusgroup="tablist nomemory" aria-label="Pilih fokus peran dan studi kasus">
            {ROLE_LENSES.map((lens, idx) => (
              <button
                type="button"
                id={`hero-role-tab-${lens.id}`}
                class="hero-role-tab"
                role="tab"
                aria-controls={`hero-role-panel-${lens.id}`}
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-role-tab={lens.id}
                data-spark
                {...(idx === 0 ? { focusgroupstart: '' } : {})}
              >
                {lens.label}
              </button>
            ))}
            <span class="tf-frame" aria-hidden="true">
              <span class="tf-corner tf-tl"></span>
              <span class="tf-corner tf-tr"></span>
              <span class="tf-corner tf-bl"></span>
              <span class="tf-corner tf-br"></span>
            </span>
          </div>
        </div>

        <div class="hero-role-panels">
          {ROLE_LENSES.map((lens, idx) => (
            <div
              role="tabpanel"
              id={`hero-role-panel-${lens.id}`}
              aria-labelledby={`hero-role-tab-${lens.id}`}
              hidden={idx !== 0 ? 'until-found' : undefined}
              tabindex={idx === 0 ? 0 : undefined}
            >
              <div class="hero-role-card">
                <p class="hero-role-summary" data-role-summary data-decrypt={idx === 0 ? '' : undefined}>{lens.summary}</p>
                <div class="hero-proof-links">
                  {lens.proofs.map(proof => (
                    <button type="button" class="hero-proof-chip mono" data-project={proof.id}>
                      <span>{proof.name}</span>
                      <span aria-hidden="true">↗</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Portrait 3D Lanyard Panel (WebGL Three.js + ReactBits Physics & Fallback) -->
    <aside
      class="photo-showcase-panel lanyard-panel"
      id="photo-panel"
      aria-label="Kartu profil 3D lanyard interaktif"
      data-enter="4"
      data-lanyard-flipped="false"
      data-lanyard-ready="pending"
    >
      <!-- Three.js WebGL Hanging Lanyard Mount Stage -->
      <div class="lanyard-three-stage" id="hero-lanyard-three"></div>

      <!-- Accessible Corner Flip Trigger (tetap berfungsi untuk Keyboard Tab & 3D) -->
      <button
        type="button"
        class="lanyard-corner-flip"
        data-hero-flip
        aria-label="Balik kartu profil untuk melihat sertifikasi dan tautan"
        aria-pressed="false"
        title="Balik kartu (atau klik langsung pada kartu)"
      >
        <svg class="btn-svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
        </svg>
      </button>

      <!-- LCP HTML Portrait & Reduced-Motion / Non-WebGL Fallback Card -->
      <div class="lanyard-fallback-stage" id="hero-lanyard-fallback">
        <div class="lanyard-flipper" id="hero-lanyard-flipper">
          <div class="lanyard-face lanyard-face-front" id="hero-lanyard-front">
            <div class="photo-frame has-photo lanyard-badge-card" id="photo-frame">
              <picture>
                <source srcset="/foto-profil.webp" type="image/webp" />
                <img
                  id="profile-photo"
                  class="profile-photo"
                  src="/foto-profil.jpg"
                  alt="Foto profil Maulana Ahmad Bukhori"
                  width="560"
                  height="700"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
              <div class="photo-dock">
                <strong class="photo-dock-title display">{SITE_CONFIG.fullName}</strong>
                <span class="photo-dock-sub">“{SITE_CONFIG.photoQuote}”</span>
              </div>
            </div>
          </div>

          <div class="lanyard-face lanyard-face-back" id="hero-lanyard-back" inert>
            <div class="lanyard-back-card">
              <div class="lanyard-back-head">
                <div class="lanyard-back-identity">
                  <span class="lanyard-back-handle mono">@{SITE_CONFIG.githubHandle}</span>
                  <span class="lanyard-back-campus">{SITE_CONFIG.program}</span>
                </div>
                <span class="lanyard-availability-pill">
                  <span class="status-dot" aria-hidden="true"></span>
                  <span>{SITE_CONFIG.availability}</span>
                </span>
              </div>

              <div class="lanyard-back-section">
                <h2 class="lanyard-back-heading">Sertifikasi Terverifikasi</h2>
                <ul class="lanyard-cred-list">
                  {CERTIFICATIONS.map((cert) => (
                    <li>
                      <a
                        class="lanyard-cred-item"
                        href={cert.credentialUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <div class="lanyard-cred-copy">
                          <span class="lanyard-cred-title">{cert.name}</span>
                          <span class="lanyard-cred-meta">{cert.issuer} · {cert.year}</span>
                        </div>
                        <span class="lanyard-cred-arrow mono" aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="lanyard-back-section">
                <h2 class="lanyard-back-heading">Tautan Langsung</h2>
                <div class="lanyard-link-list">
                  <a
                    class="lanyard-link-item"
                    href={SITE_CONFIG.github}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="lanyard-link-name">GitHub</span>
                    <span class="lanyard-link-val mono">/{SITE_CONFIG.githubHandle} ↗</span>
                  </a>
                  <a
                    class="lanyard-link-item"
                    href={SITE_CONFIG.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="lanyard-link-name">LinkedIn</span>
                    <span class="lanyard-link-val mono">/in/maulanahb ↗</span>
                  </a>
                  <button
                    type="button"
                    class="lanyard-link-item"
                    data-copy-email={SITE_CONFIG.email}
                  >
                    <span class="lanyard-link-name">Salin Email</span>
                    <span class="lanyard-link-val mono">{SITE_CONFIG.email}</span>
                  </button>
                </div>
              </div>

              <div class="lanyard-back-foot">
                <span class="lanyard-back-loc mono">Polinema · Malang</span>
                <button
                  type="button"
                  class="lanyard-flip-btn"
                  data-hero-flip
                  aria-label="Kembali ke sisi depan foto profil"
                >
                  <span aria-hidden="true">↻</span>
                  <span>Depan</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Touch Affordance Hint for Card Flip -->
      <button
        type="button"
        class="lanyard-touch-hint mono"
        data-hero-flip
        aria-label="Ketuk kartu untuk melihat sertifikasi dan tautan"
      >
        <span>Ketuk kartu</span>
        <span aria-hidden="true">↻</span>
      </button>
    </aside>
  </div>
  </div>
</section>

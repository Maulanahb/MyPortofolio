---
// Hero Section with Main Bio Panel & Interactive Photo Frame
---
<section class="hero shell" aria-labelledby="hero-title">
  <div class="chapter-kicker mono">✦ CHAPTER 00 <span>PERKENALAN &amp; PROFIL UTAMA</span></div>

  <div class="hero-grid">
    <!-- Main Bio Panel -->
    <div class="hero-main-panel comic-panel">
      <div class="comic-page-index mono">P.001 <span>✦</span> PROFIL UTAMA</div>
      <h1 class="hero-title display" id="hero-title">HALO, SAYA<br/><span class="highlight hero-name">MAULANA AHMAD BUKHORI!</span></h1>
      <div class="hero-lead">
        <span>JUNIOR SYSTEM ANALYST</span>
        <span class="star-divider">✳</span>
        <span>JUNIOR WEB &amp; MOBILE DEVELOPER</span>
      </div>
      <p class="hero-desc">Mahasiswa D-IV Sistem Informasi Bisnis (Semester 5), Politeknik Negeri Malang. Fokus pada analisis sistem, pemodelan basis data, serta pengembangan web dan mobile di tingkat junior.</p>
      <div class="hero-actions">
        <a class="button dark action-manga hero-btn-primary" href="#pekerjaan">
          <svg class="btn-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
          </svg>
          <span>LIHAT PROYEK</span> <span class="arrow">↗</span>
        </a>
        <a class="button yellow hero-btn-icon" href="/CV-Maulana-Ahmad-Bukhori.pdf" download="CV-Maulana-Ahmad-Bukhori.pdf" aria-label="Unduh CV (PDF)" title="Unduh CV (PDF)">
          <svg class="btn-svg" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/>
          </svg>
          <span class="btn-label">UNDUH CV <span class="arrow">↓</span></span>
        </a>
        <a class="button hero-btn-icon" href="#kontak" aria-label="Hubungi Saya" title="Hubungi Saya">
          <svg class="btn-svg" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span class="btn-label">HUBUNGI SAYA <span class="arrow">→</span></span>
        </a>
      </div>
      <span class="background-sfx display" aria-hidden="true">ドン!!</span>
    </div>

    <!-- Interactive Photo Panel -->
    <div class="photo-comic-panel comic-panel" id="photo-panel">
      <div class="photo-speedlines" aria-hidden="true"></div>
      <div class="photo-halftone" aria-hidden="true"></div>
      <div class="photo-label mono">CHARACTER FILE <strong>#001</strong></div>
      <div class="photo-frame has-photo" id="photo-frame">
        <picture>
          <source srcset="/foto-profil.webp" type="image/webp" />
          <img
            id="profile-photo"
            class="profile-photo"
            src="/foto-profil.jpg"
            alt="Foto profil profesional Maulana Ahmad Bukhori"
            width="560"
            height="700"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="photo-sfx display" aria-hidden="true">ゴゴゴ</div>
      <div class="photo-caption">
        <span class="photo-caption-name display">MAULANA AHMAD BUKHORI</span>
        <span class="photo-caption-sub mono">D-IV SISTEM INFORMASI BISNIS · POLINEMA (SMT 5)</span>
      </div>
    </div>
  </div>
</section>


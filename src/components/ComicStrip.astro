---
// 3-Panel Comic Strip Narrative
---
<div class="shell">
  <div class="comic-strip" aria-label="Panel pengantar portofolio">
    <div class="strip-panel strip-one">
      <span class="strip-number mono">PANEL 01</span>
      <span class="strip-big display">IDE!</span>
      <span class="strip-caption mono">MULAI DARI MASALAH</span>
    </div>
    <div class="strip-panel strip-two">
      <span class="strip-number mono">PANEL 02</span>
      <span class="strip-action display">BUILD<span>!</span></span>
      <span class="strip-caption mono">UBAH JADI SOLUSI</span>
    </div>
    <div class="strip-panel strip-three">
      <span class="strip-number mono">PANEL 03</span>
      <span class="strip-impact display">SHIP IT.</span>
      <span class="strip-caption mono">UJI · RAPIIKAN · RILIS</span>
    </div>
  </div>
</div>


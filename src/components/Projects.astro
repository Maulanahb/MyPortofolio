---
import { PROJECTS } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="section shell" id="pekerjaan" aria-labelledby="project-title">
  <div class="chapter-kicker mono">✦ CHAPTER 02 <span>STUDI KASUS PROYEK UTAMA</span></div>
  <div class="section-head">
    <div>
      <div class="eyebrow mono">✦ STUDI KASUS PILIHAN</div>
      <h2 id="project-title" class="section-title display">STUDI KASUS PROYEK<br/><span class="title-highlight">&amp; PENGEMBANGAN SISTEM.</span></h2>
    </div>
  </div>

  <div class="projects-grid">
    {PROJECTS.map(project => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>

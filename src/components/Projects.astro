---
import { PROJECTS } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="section shell" id="pekerjaan" aria-labelledby="project-title">
  <div class="chapter-kicker mono">✦ CHAPTER 02 <span>STUDI KASUS PROYEK UTAMA</span></div>
  <div class="section-head">
    <div>
      <div class="eyebrow mono">03 / Proyek terpilih (Sistem Informasi &amp; Pengembangan Aplikasi)</div>
      <h2 id="project-title" class="section-title display">EMPAT PROYEK.<br/><span class="title-highlight">DARI ANALISIS KE PRODUK.</span></h2>
    </div>
    <p class="section-aside">
      Setiap proyek mencakup identifikasi masalah bisnis (<em>As-Is</em>), peran spesifik, pemodelan sistem (BPMN, UML, ERD, SRS/PRD), implementasi kode, hingga dampak terukur.
    </p>
  </div>

  <div class="projects-grid">
    {PROJECTS.map(project => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>

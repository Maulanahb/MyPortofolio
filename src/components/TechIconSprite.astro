---
// Sprite ikon teknologi: dirender sekali di Layout, dipakai lewat <use href="#tech-*">.
import { TECH_ICONS } from '../data/tech-icons';

const icons = Object.entries(TECH_ICONS);
---

<svg
  class="tech-icon-sprite"
  aria-hidden="true"
  focusable="false"
  width="0"
  height="0"
  style="position:absolute;width:0;height:0;overflow:hidden"
>
  {icons.map(([id, icon]) => (
    <symbol id={`tech-${id}`} viewBox="0 0 24 24">
      {icon.stroke ? (
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          {icon.paths.map(d => <path d={d} />)}
        </g>
      ) : (
        icon.paths.map(d => <path d={d} />)
      )}
    </symbol>
  ))}
</svg>

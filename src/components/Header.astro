---
// Site Header & Navigation
---
<header class="site-header">
  <div class="shell header-inner">
    <!-- Brand Logo Mark -->
    <a class="brand" href="#beranda" aria-label="Kembali ke beranda">
      <span class="brand-mark">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
          <path d="m5 19 7-14 7 14M7.5 14h9" stroke="#fff" stroke-width="3" stroke-linecap="square"/>
        </svg>
      </span>
      <span class="brand-word display">MAULANA<span>.</span>DEV</span>
    </a>

    <!-- Navigation Links -->
    <nav id="nav" class="nav" aria-label="Menu utama">
      <a href="#tentang">Tentang</a>
      <a href="#keahlian">Skills</a>
      <a href="#pekerjaan">Proyek</a>
      <a href="#pengalaman">Pengalaman</a>
      <a href="#pendidikan">Pendidikan</a>
      <a href="#kontak">Kontak</a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <div class="header-actions">
      <button class="button tiny mobile-menu-btn" id="menu-toggle" aria-expanded="false" aria-controls="nav" type="button">Menu</button>
    </div>
  </div>
</header>

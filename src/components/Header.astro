---
// Site Header & Floating Frosted Glass Navigation
---
<header class="site-header" id="site-header" data-scrolled-nav role="banner">
  <div class="shell">
    <div class="header-inner" id="header-inner">
      <!-- Clean Geometric Monogram Brand -->
      <a class="brand" href="#beranda" aria-label="Beranda Maulana" draggable="false">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19V5l8 9 8-9v14" />
          </svg>
        </span>
        <span class="brand-word display">Maulana.dev</span>
      </a>

      <!-- Navigation Links -->
      <nav id="nav" class="nav" aria-label="Menu utama">
        <a href="#tentang" data-nav="tentang">Tentang</a>
        <a href="#keahlian" data-nav="keahlian">Skills</a>
        <a href="#pekerjaan" data-nav="pekerjaan">Proyek</a>
        <a href="#pengalaman" data-nav="pengalaman">Pengalaman</a>
        <a href="#pendidikan" data-nav="pendidikan">Pendidikan</a>
        <a href="#kontak" data-nav="kontak">Kontak</a>
      </nav>

      <!-- Header Utilities: Theme Mode Cycle, Quick Search (Cmd+K), Mobile Drawer -->
      <div class="header-actions">
        <button
          type="button"
          class="theme-pill-btn"
          id="theme-toggle-btn"
          aria-label="Ganti tema warna tampilan (tekan T)"
          title="Ganti Tema: Daylight / Obsidian / Graphite (Shortcut: T)"
        >
          <span class="theme-dot" aria-hidden="true"></span>
          <span id="palette-label">Daylight</span>
        </button>

        <button
          type="button"
          class="cmd-trigger"
          id="command-button"
          aria-label="Buka navigasi cepat"
          title="Navigasi Cepat (Ctrl+K / Cmd+K)"
        >
          <span class="cmd-text">Cari</span>
          <span class="kbd-hint">⌘K</span>
        </button>

        <button
          class="mobile-menu-btn"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="nav"
          type="button"
          aria-label="Buka menu navigasi"
          title="Menu Navigasi"
        >
          <svg class="icon-menu-bars" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>
          </svg>
          <svg class="icon-menu-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="header-progress-track" aria-hidden="true">
        <span class="scroll-progress-line"></span>
      </div>
    </div>
  </div>
</header>

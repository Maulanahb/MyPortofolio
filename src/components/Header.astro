---
// Site Header & Floating Frosted Glass Navigation
---
<header class="site-header" id="site-header" data-scrolled-nav role="banner">
  <div class="shell">
    <div class="header-inner" id="header-inner">
      <!-- Clean Geometric Monogram Brand -->
      <a class="brand" href="#beranda" aria-label="Beranda Maulana" draggable="false">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19V5l8 9 8-9v14" />
          </svg>
        </span>
        <span class="brand-word display">Maulana.dev</span>
      </a>

      <!-- Navigation Links -->
      <nav id="nav" class="nav" aria-label="Menu utama">
        <a href="#tentang" data-nav="tentang">Tentang</a>
        <a href="#keahlian" data-nav="keahlian">Skills</a>
        <a href="#pekerjaan" data-nav="pekerjaan">Proyek</a>
        <a href="#pengalaman" data-nav="pengalaman">Pengalaman</a>
        <a href="#pendidikan" data-nav="pendidikan">Pendidikan</a>
        <a href="#kontak" data-nav="kontak">Kontak</a>
      </nav>

      <!-- Header Utilities: 3-Mode Icon Switcher, Quick Search (Cmd+K), Mobile Drawer -->
      <div class="header-actions">
        <div
          class="theme-switch"
          id="theme-switcher"
          role="radiogroup"
          aria-label="Pilih tema warna tampilan"
        >
          <span class="theme-switch-thumb" aria-hidden="true"></span>

          <button
            type="button"
            role="radio"
            class="theme-switch-btn"
            data-palette-option="daylight"
            aria-checked="true"
            aria-label="Tema Daylight (Terang)"
            title="Daylight · Terang (Shortcut: T)"
            tabindex="0"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>

          <button
            type="button"
            role="radio"
            class="theme-switch-btn"
            data-palette-option="obsidian"
            aria-checked="false"
            aria-label="Tema Obsidian (Gelap)"
            title="Obsidian · Gelap (Shortcut: T)"
            tabindex="-1"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
          </button>

          <button
            type="button"
            role="radio"
            class="theme-switch-btn"
            data-palette-option="graphite"
            aria-checked="false"
            aria-label="Tema Graphite (Netral Hangat)"
            title="Graphite · Netral Hangat (Shortcut: T)"
            tabindex="-1"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="8" />
              <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none" />
            </svg>
          </button>
        </div>

        <button
          type="button"
          class="cmd-trigger"
          id="command-button"
          aria-label="Buka navigasi cepat"
          title="Navigasi Cepat (Ctrl+K / Cmd+K)"
        >
          <span class="cmd-text">Cari</span>
          <span class="kbd-hint">⌘K</span>
        </button>

        <button
          class="mobile-menu-btn"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="nav"
          type="button"
          aria-label="Buka menu navigasi"
          title="Menu Navigasi"
        >
          <svg class="icon-menu-bars" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>
          </svg>
          <svg class="icon-menu-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="header-progress-track" aria-hidden="true">
        <span class="scroll-progress-line"></span>
      </div>
    </div>
  </div>
</header>

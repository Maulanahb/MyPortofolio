---
import type { ProjectItem } from '../data/projects';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isFeatured = project.id === 'cuciin';
---

<article
  class={`project-card card-${project.id}${isFeatured ? ' card-featured' : ''}`}
  data-project-id={project.id}
  data-domains={project.domains.join(',')}
  data-skill-ids={project.skillIds.join(',')}
  data-spotlight
  data-reveal
  style={`--vt-name: project-card-${project.id};`}
>
  <div class={`project-art poster-${project.id}`} data-art={project.id}>
    {/* 1. FEATURED FULL-WIDTH: CUCI.IN — Kasir Laundry & Cek Nota Instan */}
    {project.id === 'cuciin' && (
      <div class="cuciin-poster-grid">
        <div class="poster-editorial-col">
          <div class="poster-brand-row">
            <span class="poster-brand-logo">
              <img
                src="/projects/cuciin-logo.svg"
                alt="Logo CUCI.IN"
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="poster-brand-name">CUCI.IN</span>
            <span class="poster-pill mono">{project.badge}</span>
          </div>

          <p class="poster-headline display">{project.posterHeadline}</p>
          <p class="poster-subline">{project.posterSubline}</p>

          <div
            class="cuciin-screen-switch"
            role="tablist"
            aria-label="Pilih tampilan layar CUCI.IN"
          >
            <button
              type="button"
              role="tab"
              class="cuciin-switch-btn is-active"
              data-cuciin-view="dashboard"
              aria-selected="true"
              aria-pressed="true"
            >
              Dashboard Admin
            </button>
            <button
              type="button"
              role="tab"
              class="cuciin-switch-btn"
              data-cuciin-view="lookup"
              aria-selected="false"
              aria-pressed="false"
            >
              Lacak Cucian
            </button>
          </div>
        </div>

        <div class="poster-stage-col">
          <div class="ci-frame">
            <div class="ci-frame-chrome">
              <div class="ci-frame-dots" aria-hidden="true">
                <span class="dot r"></span>
                <span class="dot y"></span>
                <span class="dot g"></span>
              </div>
              <span class="ci-frame-url mono">cuci.in · Simulasi Outlet</span>
              <span class="ci-frame-tag mono">F2 Transaksi Baru</span>
            </div>

            {/* Screen A: Dashboard Admin CUCI.IN (sumber: resources/views/admin/dashboard.blade.php) */}
            <div class="ci-screen is-active" data-cuciin-panel="dashboard">
              <div class="ci-welcome-banner">
                <div>
                  <div class="ci-welcome-title">Selamat Datang, Admin!</div>
                  <div class="ci-welcome-sub">Pantau pemasukan, piutang nota, dan antrean cucian harian.</div>
                </div>
                <span class="ci-cta-pill">+ Transaksi Baru</span>
              </div>

              <div class="ci-kpi-grid">
                <div class="ci-kpi-card">
                  <span class="ci-kpi-label">Pemasukan Hari Ini</span>
                  <strong class="ci-kpi-val mono">Rp 1.480.000</strong>
                  <span class="ci-kpi-chip up">+12,4% dr kemarin</span>
                </div>
                <div class="ci-kpi-card">
                  <span class="ci-kpi-label">Pemasukan Bulan Ini</span>
                  <strong class="ci-kpi-val mono">Rp 28.450.000</strong>
                  <span class="ci-kpi-note">Tunai, Transfer &amp; QRIS</span>
                </div>
                <div class="ci-kpi-card">
                  <span class="ci-kpi-label">Piutang Berjalan</span>
                  <strong class="ci-kpi-val mono">Rp 420.000</strong>
                  <span class="ci-kpi-chip warn">Nota DP / Belum Lunas</span>
                </div>
                <div class="ci-kpi-card">
                  <span class="ci-kpi-label">Transaksi Hari Ini</span>
                  <strong class="ci-kpi-val mono">34 Nota</strong>
                  <span class="ci-kpi-note">Rata-rata Rp 43.500</span>
                </div>
              </div>

              <div class="ci-lower-split">
                <div class="ci-chart-box">
                  <div class="ci-chart-head">
                    <span class="ci-chart-title">Pemasukan 7 Hari Terakhir</span>
                    <span class="ci-peak-pill mono">Puncak · Sab</span>
                  </div>
                  <svg
                    viewBox="0 0 320 96"
                    class="ci-area-svg"
                    role="img"
                    aria-label="Ilustrasi grafik area pemasukan 7 hari dashboard admin CUCI.IN"
                  >
                    <defs>
                      <linearGradient id="ciRevenueArea" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0e7490" stop-opacity="0.32" />
                        <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.02" />
                      </linearGradient>
                    </defs>
                    <line x1="12" y1="24" x2="308" y2="24" stroke="#e2e8f0" stroke-dasharray="3 3" stroke-width="1" />
                    <line x1="12" y1="52" x2="308" y2="52" stroke="#e2e8f0" stroke-dasharray="3 3" stroke-width="1" />
                    <line x1="12" y1="80" x2="308" y2="80" stroke="#cbd5e1" stroke-width="1" />
                    <path
                      d="M 16,66 C 42,66 44,50 64,50 C 86,50 92,58 112,58 C 134,58 140,34 160,34 C 182,34 188,42 208,42 C 230,42 236,16 256,16 C 276,16 284,26 304,26 L 304,80 L 16,80 Z"
                      fill="url(#ciRevenueArea)"
                    />
                    <path
                      d="M 16,66 C 42,66 44,50 64,50 C 86,50 92,58 112,58 C 134,58 140,34 160,34 C 182,34 188,42 208,42 C 230,42 236,16 256,16 C 276,16 284,26 304,26"
                      fill="none"
                      stroke="#0e7490"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    />
                    <circle cx="256" cy="16" r="5" fill="#f59e0b" fill-opacity="0.28" />
                    <circle cx="256" cy="16" r="3" fill="#f59e0b" stroke="#ffffff" stroke-width="1.5" />
                    <circle cx="304" cy="26" r="3" fill="#06b6d4" stroke="#ffffff" stroke-width="1.5" />
                  </svg>
                </div>

                <div class="ci-pipeline-box">
                  <div class="ci-chart-title">Antrean Status Cucian</div>
                  <div class="ci-status-grid">
                    <div class="ci-status-pill sky">
                      <span>Diterima</span>
                      <strong class="mono">8</strong>
                    </div>
                    <div class="ci-status-pill amber">
                      <span>Diproses</span>
                      <strong class="mono">14</strong>
                    </div>
                    <div class="ci-status-pill emerald">
                      <span>Selesai</span>
                      <strong class="mono">9</strong>
                    </div>
                    <div class="ci-status-pill slate">
                      <span>Diambil</span>
                      <strong class="mono">12</strong>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Screen B: Lacak Nota Publik Tanpa Login (sumber: resources/views/lookup/_content.blade.php) */}
            <div class="ci-screen" data-cuciin-panel="lookup" hidden>
              <div class="ci-lookup-search">
                <div class="ci-lookup-input mono">TRX-0042</div>
                <span class="ci-cta-pill">Cek Transaksi</span>
              </div>

              <div class="ci-lookup-card">
                <div class="ci-lookup-head">
                  <div>
                    <span class="ci-kpi-label">Status Cucian</span>
                    <div class="ci-lookup-status">Diproses · Sedang Dicuci &amp; Disetrika</div>
                  </div>
                  <div class="ci-lookup-eta">
                    <span class="ci-kpi-label">Perkiraan Selesai</span>
                    <strong class="mono">Hari ini, 17:30 WIB</strong>
                  </div>
                </div>

                <div class="ci-stepper" aria-label="Tahapan status cucian">
                  <div class="ci-step is-done">
                    <span class="ci-step-dot">✓</span>
                    <span>Diterima</span>
                  </div>
                  <div class="ci-step is-current">
                    <span class="ci-step-dot">●</span>
                    <span>Diproses</span>
                  </div>
                  <div class="ci-step">
                    <span class="ci-step-dot">3</span>
                    <span>Selesai</span>
                  </div>
                  <div class="ci-step">
                    <span class="ci-step-dot">4</span>
                    <span>Diambil</span>
                  </div>
                </div>

                <div class="ci-lookup-summary">
                  <div class="ci-sum-cell">
                    <span>Layanan</span>
                    <strong>Cuci Komplit · 4,5 kg</strong>
                  </div>
                  <div class="ci-sum-cell">
                    <span>Total Tagihan</span>
                    <strong class="mono">Rp 36.000</strong>
                  </div>
                  <div class="ci-sum-cell">
                    <span>Sisa Bayar</span>
                    <strong class="mono ci-due">Rp 16.000 (DP)</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* 2. BAWANGHUB: Web AI Agritech & Cuaca Nganjuk */}
    {project.id === 'bawanghub' && (
      <div class="poster-card-stack">
        <div class="poster-top-copy">
          <div class="poster-brand-row">
            <span class="poster-brand-name">BAWANGHUB</span>
            <span class="poster-pill mono">{project.badge}</span>
          </div>
          <p class="poster-headline display">{project.posterHeadline}</p>
          <p class="poster-subline">{project.posterSubline}</p>
        </div>

        <div class="bh-poster-window">
          <div class="bh-win-bar">
            <div class="ci-frame-dots" aria-hidden="true">
              <span class="dot r"></span>
              <span class="dot y"></span>
              <span class="dot g"></span>
            </div>
            <span class="bh-win-url mono">bawanghub.app</span>
            <span class="bh-pwa-chip mono">PWA Siap Offline</span>
          </div>
          <div class="bh-poster-body">
            <div class="bh-side-col">
              <span class="bh-nav-item active">Dashboard</span>
              <span class="bh-nav-item">Tanya AI</span>
              <span class="bh-nav-item">Statistik</span>
              <span class="bh-nav-item">Buku Tani</span>
            </div>
            <div class="bh-content-col">
              <div class="bh-top-cards">
                <div class="bh-ai-card">
                  <span class="bh-tag">Gemini AI · Tanya Budidaya</span>
                  <strong>&ldquo;Ujung daun bawang menguning, semprot apa?&rdquo;</strong>
                  <p>Cek dosis fungisida &amp; drainase bedengan pagi hari.</p>
                </div>
                <div class="bh-weather-mini">
                  <span class="bh-tag">Open-Meteo · Nganjuk</span>
                  <strong class="mono">29°C</strong>
                  <span>Cerah Berawan</span>
                </div>
              </div>
              <div class="bh-price-strip">
                <div class="bh-price-meta">
                  <span>Tren Harga Pasar</span>
                  <strong class="mono">Rp 34.500/kg</strong>
                </div>
                <svg viewBox="0 0 180 34" class="bh-spark-svg" aria-hidden="true">
                  <polyline
                    points="4,28 34,24 64,26 94,18 124,20 150,11 176,8"
                    fill="none"
                    stroke="#059669"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle cx="176" cy="8" r="3" fill="#059669" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* 3. LAPANGKU: Flutter Booking Lapangan + Midtrans E-Ticket */}
    {project.id === 'lapangku' && (
      <div class="poster-card-stack">
        <div class="poster-top-copy">
          <div class="poster-brand-row">
            <img
              src="/projects/lapangku-icon.webp"
              alt="Logo Lapangku"
              class="lk-poster-icon"
              width="22"
              height="22"
              loading="lazy"
              decoding="async"
            />
            <span class="poster-brand-name">LAPANGKU</span>
            <span class="poster-pill mono">{project.badge}</span>
          </div>
          <p class="poster-headline display">{project.posterHeadline}</p>
          <p class="poster-subline">{project.posterSubline}</p>
        </div>

        <div class="lk-poster-stage">
          <div class="lk-venue-card">
            <img
              src="/projects/futsal.webp"
              alt="Lapangan futsal indoor Champions Arena"
              class="lk-venue-img"
              width="240"
              height="135"
              loading="lazy"
              decoding="async"
            />
            <div class="lk-venue-info">
              <span class="lk-badge">Futsal Indoor</span>
              <strong>Champions Arena</strong>
              <span class="mono">Rp 120.000 / jam</span>
            </div>
          </div>

          <div class="lk-venue-card">
            <img
              src="/projects/minisoccer.webp"
              alt="Lapangan mini soccer Stadion Gajayana"
              class="lk-venue-img"
              width="240"
              height="135"
              loading="lazy"
              decoding="async"
            />
            <div class="lk-venue-info">
              <span class="lk-badge green">Mini Soccer 7v7</span>
              <strong>Stadion Gajayana</strong>
              <span class="mono">Rp 350.000 / jam</span>
            </div>
          </div>

          <div class="lk-ticket-strip">
            <div>
              <span class="lk-ticket-kicker mono">E-TICKET · MIDTRANS LUNAS</span>
              <strong>Kode LPK-20261028-009</strong>
            </div>
            <div class="lk-qr-box" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <path d="M14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 21h3" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* 4. PORTAL LAB IVSS: Web Riset Polinema (#0A192F + gedung.webp) */}
    {project.id === 'ivss' && (
      <div class="poster-card-stack">
        <div class="poster-top-copy">
          <div class="poster-brand-row">
            <img
              src="/projects/IVSS.webp"
              alt="Logo Lab IVSS"
              class="ivss-poster-logo"
              width="24"
              height="24"
              loading="lazy"
              decoding="async"
            />
            <span class="poster-brand-name">LAB IVSS POLINEMA</span>
            <span class="poster-pill mono">{project.badge}</span>
          </div>
          <p class="poster-headline display">{project.posterHeadline}</p>
          <p class="poster-subline">{project.posterSubline}</p>
        </div>

        <div class="ivss-browser-frame">
          <div class="ivss-mini-nav">
            <span class="ivss-mini-brand mono">IVSS · JTI</span>
            <div class="ivss-mini-links">
              <span>Home</span>
              <span>News</span>
              <span>Research</span>
              <span>Members</span>
            </div>
          </div>

          <div class="ivss-hero-crop">
            <img
              src="/projects/gedung.webp"
              alt="Gedung Laboratorium IVSS JTI Politeknik Negeri Malang"
              class="ivss-gedung-img"
              width="480"
              height="240"
              loading="lazy"
              decoding="async"
            />
            <div class="ivss-hero-overlay">
              <span class="ivss-hero-kicker mono">INTELLIGENT VISION &amp; SMART SYSTEM</span>
              <strong>Portal Berita, Anggota Peneliti &amp; Fasilitas Lab</strong>
            </div>
          </div>

          <div class="ivss-stat-bar mono">
            <span>4 Peran Akses</span>
            <span>Panel Admin Berita</span>
            <span>PostgreSQL Cepat</span>
          </div>
        </div>
      </div>
    )}

    {/* 5. AI FINANCE (AIAAS): Neo-Brutalist Cream Canvas (#f5f1e6 + #0b63f6 + #ffc83d) */}
    {project.id === 'aiaas' && (
      <div class="poster-card-stack">
        <div class="poster-top-copy">
          <div class="poster-brand-row">
            <span class="ai-poster-mark">AI</span>
            <span class="poster-brand-name ai-dark-word">AI FINANCE</span>
            <span class="poster-pill ai-brutal-pill mono">{project.badge}</span>
          </div>
          <p class="poster-headline display ai-dark-text">{project.posterHeadline}</p>
          <p class="poster-subline ai-dark-muted">{project.posterSubline}</p>
        </div>

        <div class="ai-poster-frame">
          <div class="ai-chat-input-bar">
            <span class="ai-chat-prompt">&ldquo;Beli kopi 25rb kemarin&rdquo;</span>
            <span class="ai-chat-tag mono">✓ Konsumsi · -Rp 25.000</span>
          </div>

          <div class="ai-brutal-grid">
            <div class="ai-balance-card">
              <span>Total Saldo Bersih</span>
              <strong class="mono">Rp 14.250.000</strong>
              <span class="ai-stabil-badge">Kas Stabil</span>
            </div>

            <div class="ai-mini-metrics">
              <div class="ai-metric mint">
                <span>Pemasukan</span>
                <strong class="mono">+Rp 5.000.000</strong>
              </div>
              <div class="ai-metric coral">
                <span>Pengeluaran</span>
                <strong class="mono">-Rp 375.000</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>

  <footer class="project-footer">
    <div class="project-footer-text">
      <h3 class="project-name display">{project.title}</h3>
      <p class="project-meta">{project.cardMeta}</p>
    </div>
    <button
      type="button"
      class="project-open-btn"
      data-project={project.id}
      aria-label={`Buka studi kasus ${project.title}`}
      title={`Buka studi kasus ${project.title}`}
    >
      <span aria-hidden="true">&#8599;</span>
    </button>
  </footer>
</article>

---
import type { ProjectItem } from '../data/projects';
import TechTag from './TechTag.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<article class={`project-card card-${project.id}`} data-project-id={project.id}>
  <div class={`project-art ${project.theme}`} data-art={project.id}>
    <span class={`project-sfx ${project.sfxClass || ''} display`} aria-hidden="true">{project.sfx}</span>
    <span class="art-corner mono">{project.badge}</span>
    <span class="art-preview-pill mono" title="Simulasi pratinjau antarmuka proyek">
      <span class="preview-pulse-dot"></span>
      {project.id === 'cuciin' ? 'LIVE DEMO PREVIEW' : 'PRATINJAU · PREVIEW'}
    </span>

    {/* 1. BAWANGHUB: Smart Agriculture & Gemini AI Dashboard (Google Juara Vibe Coding) */}
    {project.theme === 'agri' && (
      <div class="app-bawanghub web-window" aria-label="Pratinjau antarmuka BawangHub Smart Agriculture Dashboard">
        {/* Clean Web Browser Window Bar (No black bar, no 'web online' tags) */}
        <div class="web-window-bar">
          <div class="web-window-dots" aria-hidden="true">
            <span class="w-dot red"></span>
            <span class="w-dot yellow"></span>
            <span class="w-dot green"></span>
          </div>
          <div class="web-window-url mono">
            <svg viewBox="0 0 24 24" width="7" height="7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>bawanghub.app</span>
          </div>
        </div>

        {/* Dashboard Layout: Sidebar + Main Content */}
        <div class="bh-desktop-layout">
          {/* Sidebar */}
          <aside class="bh-side-nav">
            <div class="bh-nav-brand">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
              <span>Bawang<strong>Hub</strong></span>
            </div>
            <nav class="bh-nav-links">
              <div class="bh-link active">
                <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                <span>Dashboard</span>
              </div>
              <div class="bh-link">
                <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/></svg>
                <span>Tanya AI</span>
              </div>
              <div class="bh-link">
                <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                <span>Statistik</span>
              </div>
              <div class="bh-link">
                <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/></svg>
                <span>Buku Tani</span>
              </div>
              <div class="bh-link">
                <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span>Forum</span>
              </div>
              <div class="bh-link">
                <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                <span>Galeri</span>
              </div>
            </nav>
            <div class="bh-side-footer">
              <span class="bh-farmer-pill">Petani Bawang</span>
            </div>
          </aside>

          {/* Main Dashboard Canvas */}
          <main class="bh-main-canvas">
            {/* Top Grid: Hero Box + Weather Card */}
            <div class="bh-top-row">
              <div class="bh-hero-card">
                <div class="bh-hero-badge">Google Juara Vibe Coding</div>
                <div class="bh-hero-title">Halo, <strong>Petani Bawang!</strong></div>
                <div class="bh-hero-desc">PWA asisten AI Gemini, prediksi harga &amp; cuaca lokal.</div>
                <div class="bh-hero-btns">
                  <span class="bh-btn-green">Mulai Tanya AI</span>
                  <span class="bh-btn-outline">Cek Statistik</span>
                </div>
              </div>

              <div class="bh-weather-box">
                <div class="bh-weather-head">
                  <span>CuacaDetail</span>
                  <span class="bh-loc-tag">
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-1px;margin-right:2px;"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    Nganjuk
                  </span>
                </div>
                <div class="bh-weather-body">
                  <div class="bh-weather-temp">29°C</div>
                  <div class="bh-weather-stat">Cerah Berawan</div>
                </div>
                <div class="bh-weather-ai-tip">
                  <span>Open-Meteo:</span> Optimal untuk pemupukan.
                </div>
              </div>
            </div>

            {/* Core Feature Cards (4 Columns) */}
            <div class="bh-cards-grid">
              <div class="bh-card">
                <div class="bh-card-icon green">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/></svg>
                </div>
                <div class="bh-card-title">Tanya AI</div>
                <div class="bh-card-desc">Konsultasi budidaya via Gemini AI Proxy.</div>
                <div class="bh-card-action green">Tanya AI →</div>
              </div>

              <div class="bh-card">
                <div class="bh-card-icon blue">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                </div>
                <div class="bh-card-title">Statistik</div>
                <div class="bh-card-desc">Grafik Recharts &amp; regresi linier harga.</div>
                <div class="bh-card-action blue">Lihat Tren →</div>
              </div>

              <div class="bh-card">
                <div class="bh-card-icon amber">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/></svg>
                </div>
                <div class="bh-card-title">Buku Tani</div>
                <div class="bh-card-desc">Catatan kas harian &amp; operasional tani.</div>
                <div class="bh-card-action amber">Buka Buku →</div>
              </div>

              <div class="bh-card">
                <div class="bh-card-icon purple">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <div class="bh-card-title">Forum</div>
                <div class="bh-card-desc">Diskusi komunitas petani &amp; galeri.</div>
                <div class="bh-card-action purple">Buka Forum →</div>
              </div>
            </div>
          </main>
        </div>
      </div>
    )}

    {/* 2. LAPANGKU: Replika Akurat Flutter Multi-Role (customer_home_page.dart & booking_detail_page.dart) */}
    {project.theme === 'sport' && (
      <div class="phone-mockup-wrap">
        {/* Phone 1: Customer Home & Venue Discovery */}
        <div class="phone-mockup-chassis phone-screen-main">
          {/* Side Hardware Buttons */}
          <span class="phone-hw-btn volume-up" aria-hidden="true"></span>
          <span class="phone-hw-btn volume-down" aria-hidden="true"></span>
          <span class="phone-hw-btn power-lock" aria-hidden="true"></span>

          {/* Top Dynamic Island Notch */}
          <div class="phone-dynamic-island" aria-hidden="true">
            <span class="phone-camera-lens"></span>
            <span class="phone-speaker-slit"></span>
          </div>

          {/* Screen Glass Area */}
          <div class="phone-screen-glass">
            <div class="app-lapangku" aria-label="Pratinjau aplikasi Flutter Lapangku - Eksplorasi & Reservasi Lapangan">
              {/* Sticky White Header (customer_home_page.dart) */}
              <div class="lk-white-header">
                <div class="lk-status-bar">
                  <span class="lk-status-time mono">09:41</span>
                  <div class="lk-status-icons">
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="currentColor"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.28 19.57 10.59 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/></svg>
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="currentColor"><path d="M15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33v15.33C7 21.4 7.6 22 8.33 22h7.33c.74 0 1.34-.6 1.34-1.33V5.33C17 4.6 16.4 4 15.67 4z"/></svg>
                  </div>
                </div>

                <div class="lk-greeting-row">
                  <div class="lk-user-info">
                    <img src="./projects/lapangku-icon.png" alt="Lapangku Icon" class="lk-app-icon" loading="lazy" />
                    <div>
                      <div class="lk-hello">Halo, Sobat Maulana</div>
                      <div class="lk-loc">
                        <svg viewBox="0 0 24 24" width="6.5" height="6.5" fill="#1B6B3A"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                        Malang, Jawa Timur
                      </div>
                    </div>
                  </div>
                  <div class="lk-header-actions">
                    <span class="lk-bell-btn">
                      <svg viewBox="0 0 24 24" width="8" height="8" fill="#2D3748"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/></svg>
                    </span>
                    <span class="lk-avatar">M</span>
                  </div>
                </div>

                <div class="lk-search-pill">
                  <svg viewBox="0 0 24 24" width="7.5" height="7.5" fill="none" stroke="#A0AEC0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  <span>Cari venue atau lapangan di Malang...</span>
                </div>
              </div>

              {/* Body Content */}
              <div class="lk-body">
                {/* Category Chips */}
                <div class="lk-cat-section">
                  <div class="lk-section-title">Kategori</div>
                  <div class="lk-cat-row">
                    <span class="lk-cat-chip active">Semua</span>
                    <span class="lk-cat-chip">Futsal</span>
                    <span class="lk-cat-chip">Mini Soccer</span>
                    <span class="lk-cat-chip">Badminton</span>
                    <span class="lk-cat-chip">Basket</span>
                  </div>
                </div>

                {/* Venue List */}
                <div class="lk-section-title" style="margin-top: 2px;">Rekomendasi Terdekat</div>
                <div class="lk-field-list">
                  {/* Card 1: Champions Futsal Malang with Real Photo Asset */}
                  <div class="lk-field-card">
                    <div class="lk-field-banner">
                      <img src="./projects/futsal.jpg" alt="Foto Lapangan Futsal" class="lk-banner-photo" loading="lazy" />
                      <div class="lk-banner-badges">
                        <span class="lk-badge-cat">FUTSAL</span>
                        <span class="lk-badge-type">INDOOR</span>
                      </div>
                    </div>
                    <div class="lk-field-info">
                      <div class="lk-venue-name">CHAMPIONS ARENA MALANG</div>
                      <div class="lk-court-name">Lapangan Futsal Vinyl A</div>
                      <div class="lk-price-row">
                        <strong>Rp 120.000</strong><span> / jam</span>
                      </div>
                      <div class="lk-meta-row">
                        <span class="lk-meta-item">
                          <svg viewBox="0 0 24 24" width="6.5" height="6.5" fill="#1B6B3A" style="display:inline-block;vertical-align:-1px;margin-right:2px;"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                          1.2 km
                        </span>
                        <span class="lk-meta-item lk-rating">
                          <svg viewBox="0 0 24 24" width="6.5" height="6.5" fill="#ECC94B" style="display:inline-block;vertical-align:-1px;margin-right:2px;"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                          4.9 (128)
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* Card 2: Stadion Gajayana Mini Soccer with Real Photo Asset */}
                  <div class="lk-field-card">
                    <div class="lk-field-banner">
                      <img src="./projects/minisoccer.jpg" alt="Foto Stadion Gajayana" class="lk-banner-photo" loading="lazy" />
                      <div class="lk-banner-badges">
                        <span class="lk-badge-cat">MINI SOCCER</span>
                        <span class="lk-badge-type">OUTDOOR</span>
                      </div>
                    </div>
                    <div class="lk-field-info">
                      <div class="lk-venue-name">STADION GAJAYANA</div>
                      <div class="lk-court-name">Mini Soccer Rumput Sintetis</div>
                      <div class="lk-price-row">
                        <strong>Rp 350.000</strong><span> / jam</span>
                      </div>
                      <div class="lk-meta-row">
                        <span class="lk-meta-item">
                          <svg viewBox="0 0 24 24" width="6.5" height="6.5" fill="#1B6B3A" style="display:inline-block;vertical-align:-1px;margin-right:2px;"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                          2.4 km
                        </span>
                        <span class="lk-meta-item lk-rating">
                          <svg viewBox="0 0 24 24" width="6.5" height="6.5" fill="#ECC94B" style="display:inline-block;vertical-align:-1px;margin-right:2px;"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                          4.8 (94)
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* Bottom Navigation Bar (customer_main_page.dart) */}
              <div class="lk-bottom-nav">
                <div class="lk-nav-tab active">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                  <b>Beranda</b>
                </div>
                <div class="lk-nav-tab">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/></svg>
                  <b>Pesanan</b>
                </div>
                <div class="lk-nav-tab">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                  <b>Favorit</b>
                </div>
                <div class="lk-nav-tab">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <b>Profil</b>
                </div>
              </div>
            </div>
          </div>

          {/* Bottom Home Indicator Bar */}
          <div class="phone-home-indicator" aria-hidden="true"></div>
        </div>

        {/* Phone 2: E-Ticket Digital & QR Code Check-In (booking_detail_page.dart — Showcase in Dialog) */}
        <div class="phone-mockup-chassis phone-screen-ticket">
          {/* Side Hardware Buttons */}
          <span class="phone-hw-btn volume-up" aria-hidden="true"></span>
          <span class="phone-hw-btn volume-down" aria-hidden="true"></span>
          <span class="phone-hw-btn power-lock" aria-hidden="true"></span>

          {/* Top Dynamic Island Notch */}
          <div class="phone-dynamic-island" aria-hidden="true">
            <span class="phone-camera-lens"></span>
            <span class="phone-speaker-slit"></span>
          </div>

          {/* Screen Glass Area */}
          <div class="phone-screen-glass">
            <div class="app-lapangku lk-ticket-view" aria-label="Pratinjau E-Ticket Digital Lapangku dengan validasi QR Code">
              {/* App Bar */}
              <div class="lk-ticket-appbar">
                <div class="lk-status-bar">
                  <span class="lk-status-time mono">09:41</span>
                  <div class="lk-status-icons">
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="currentColor"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.28 19.57 10.59 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/></svg>
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="currentColor"><path d="M15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33v15.33C7 21.4 7.6 22 8.33 22h7.33c.74 0 1.34-.6 1.34-1.33V5.33C17 4.6 16.4 4 15.67 4z"/></svg>
                  </div>
                </div>
                <div class="lk-ticket-header-title">
                  <span class="lk-back-icon">‹</span>
                  <b>E-Ticket Resmi</b>
                  <span class="lk-share-icon">⤴</span>
                </div>
              </div>

              {/* Digital E-Ticket Pass */}
              <div class="lk-ticket-body">
                <div class="lk-ticket-pass">
                  {/* Ticket Header */}
                  <div class="lk-pass-head">
                    <div class="lk-pass-brand">
                      <img src="./projects/lapangku-icon.png" alt="Lapangku Icon" class="lk-pass-logo" loading="lazy" />
                      <span>LAPANGKU PASS</span>
                    </div>
                    <span class="lk-status-lunas">● LUNAS • QRIS</span>
                  </div>

                  {/* Match Information */}
                  <div class="lk-pass-match">
                    <div class="lk-match-venue">CHAMPIONS ARENA MALANG</div>
                    <div class="lk-match-court">Lapangan Futsal Vinyl A</div>
                    <div class="lk-match-time mono">Rabu, 28 Okt 2026 • 19:00 - 20:00 WIB</div>
                  </div>

                  {/* Perforated Divider */}
                  <div class="lk-pass-perforated">
                    <span class="lk-perf-cutout left"></span>
                    <span class="lk-perf-line"></span>
                    <span class="lk-perf-cutout right"></span>
                  </div>

                  {/* In-Venue QR Code Box */}
                  <div class="lk-pass-qr-box">
                    <div class="lk-qr-frame">
                      {/* Geometric SVG QR Code */}
                      <svg viewBox="0 0 100 100" width="72" height="72" fill="none">
                        {/* Finder Pattern Top-Left */}
                        <rect x="5" y="5" width="28" height="28" rx="4" fill="#1B6B3A"/>
                        <rect x="9" y="9" width="20" height="20" rx="2" fill="#ffffff"/>
                        <rect x="13" y="13" width="12" height="12" rx="2" fill="#1B6B3A"/>

                        {/* Finder Pattern Top-Right */}
                        <rect x="67" y="5" width="28" height="28" rx="4" fill="#1B6B3A"/>
                        <rect x="71" y="9" width="20" height="20" rx="2" fill="#ffffff"/>
                        <rect x="75" y="13" width="12" height="12" rx="2" fill="#1B6B3A"/>

                        {/* Finder Pattern Bottom-Left */}
                        <rect x="5" y="67" width="28" height="28" rx="4" fill="#1B6B3A"/>
                        <rect x="9" y="71" width="20" height="20" rx="2" fill="#ffffff"/>
                        <rect x="13" y="75" width="12" height="12" rx="2" fill="#1B6B3A"/>

                        {/* QR Data Grid Matrix */}

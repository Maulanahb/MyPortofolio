---
import type { ProjectItem } from '../data/projects';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<article class={`project-card card-${project.id}`} data-project-id={project.id}>
  <div class={`project-art ${project.theme}`} data-art={project.id}>
    <span class={`project-sfx ${project.sfxClass || ''} display`} aria-hidden="true">{project.sfx}</span>
    <span class="art-corner mono">{project.badge}</span>
    {project.id !== 'bawanghub' && (
      <span class="live-demo-pill mono" title="Live Interactive Demo: Coba klik dan rasakan fiturnya!">
        <span class="live-demo-pulse"></span> LIVE DEMO
      </span>
    )}

    {/* 1. BAWANGHUB: Supply Chain & Commodity Logistics Dashboard (Clean Static UI) */}
    {project.theme === 'agri' && (
      <div class="app-bawanghub browser-frame" aria-label="Pratinjau antarmuka BawangHub Supply Chain & Logistics Dashboard">
        {/* Browser Top Window Bar */}
        <div class="browser-titlebar">
          <div class="browser-dots" aria-hidden="true">
            <span class="b-dot red"></span>
            <span class="b-dot yellow"></span>
            <span class="b-dot green"></span>
          </div>
          <div class="browser-url mono">bawanghub.internal/supply-chain/inventory</div>
          <div class="browser-status mono">PROD ● ONLINE</div>
        </div>

        {/* Browser Content Canvas */}
        <div class="bawang-canvas">
          {/* Top Operational Navigation Bar */}
          <div class="bawang-topbar">
            <div class="bawang-brand">
              <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="#059669" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
              </svg>
              <span>BAWANG<strong>HUB</strong></span>
              <span class="bawang-hub-tag mono">HUB UTAMA</span>
            </div>
            <div class="bawang-top-meta mono">
              <span>MUTASI HARI INI: <strong>+12.4 TON</strong></span>
              <span class="bawang-user-pill">Admin Logistik</span>
            </div>
          </div>

          {/* KPI Summary Metric Cards (3 Columns) */}
          <div class="bawang-kpi-row">
            <div class="bawang-kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">TOTAL STOK KOMODITAS</span>
                <span class="kpi-trend up">+8.2%</span>
              </div>
              <div class="kpi-val">14.850 <span>Kg</span></div>
              <div class="kpi-sub">Kapasitas Gudang 92% (Aman)</div>
            </div>

            <div class="bawang-kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">ARMADA PENGIRIMAN</span>
                <span class="kpi-trend badge-blue">4 Truk</span>
              </div>
              <div class="kpi-val">6 <span>Dispatch</span></div>
              <div class="kpi-sub">3 Rute Antar Kota Aktif</div>
            </div>

            <div class="bawang-kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">INDEKS HARGA PASAR</span>
                <span class="kpi-trend stable">Stabil</span>
              </div>
              <div class="kpi-val">Rp 28.500 <span>/Kg</span></div>
              <div class="kpi-sub">Benchmark Pasar Induk</div>
            </div>
          </div>

          {/* Recent Dispatch Order Table */}
          <div class="bawang-table-card">
            <div class="bawang-table-head mono">
              <span>SURAT JALAN &amp; LOGISTIK GUDANG REAL-TIME</span>
              <span>STATUS</span>
            </div>
            <div class="bawang-table-body">
              <div class="bawang-table-row">
                <span class="bawang-sj mono">#SJ-8841</span>
                <span class="bawang-route">Gudang Hub Timur ➔ Pasar Induk Kramat Jati</span>
                <span class="bawang-vol mono">3.400 Kg</span>
                <span class="bawang-status green">TERKIRIM</span>
              </div>
              <div class="bawang-table-row">
                <span class="bawang-sj mono">#SJ-8842</span>
                <span class="bawang-route">Gudang Hub Barat ➔ Pusat Distribusi Cirebon</span>
                <span class="bawang-vol mono">1.950 Kg</span>
                <span class="bawang-status amber">PROSES MUAT</span>
              </div>
              <div class="bawang-table-row">
                <span class="bawang-sj mono">#SJ-8843</span>
                <span class="bawang-route">Gudang Hub Selatan ➔ Retailer Semarang</span>
                <span class="bawang-vol mono">850 Kg</span>
                <span class="bawang-status blue">EN ROUTE</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* 2. LAPANGKU: Replika Akurat Halaman Utama Flutter (customer_home_page.dart — Material Icons) */}
    {project.theme === 'sport' && (
      <div class="phone-mockup-wrap">
        <div class="phone-mockup-chassis">
          {/* Side Hardware Buttons */}
          <span class="phone-hw-btn volume-up" aria-hidden="true"></span>
          <span class="phone-hw-btn volume-down" aria-hidden="true"></span>
          <span class="phone-hw-btn power-lock" aria-hidden="true"></span>

          {/* Top Dynamic Island Notch */}
          <div class="phone-dynamic-island" aria-hidden="true">
            <span class="phone-camera-lens"></span>
            <span class="phone-speaker-slit"></span>
          </div>

          {/* Screen Glass Area */}
          <div class="phone-screen-glass">
            <div class="app-lapangku" aria-label="Pratinjau halaman Beranda aplikasi Flutter Lapangku">
              {/* Sticky White Header */}
              <div class="lk-white-header">
                <div class="lk-status-bar">
                  <span class="lk-status-time mono">09:41</span>
                  <div class="lk-status-icons">
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="currentColor"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.28 19.57 10.59 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/></svg>
                    <svg viewBox="0 0 24 24" width="7" height="7" fill="currentColor"><path d="M15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33v15.33C7 21.4 7.6 22 8.33 22h7.33c.74 0 1.34-.6 1.34-1.33V5.33C17 4.6 16.4 4 15.67 4z"/></svg>
                  </div>
                </div>
                <div class="lk-greeting-row">
                  <div>
                    <div class="lk-hello">Halo, Sobat</div>
                    <div class="lk-loc">
                      <svg viewBox="0 0 24 24" width="7" height="7" fill="#1B6B3A"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                      Malang, Jawa Timur
                    </div>
                  </div>
                  <div class="lk-header-actions">
                    <span class="lk-bell-btn">
                      <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="#2D3748"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/></svg>
                    </span>
                    <span class="lk-avatar">S</span>
                  </div>
                </div>
                <div class="lk-search-pill">
                  <svg viewBox="0 0 24 24" width="7.5" height="7.5" fill="none" stroke="#A0AEC0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  Cari lapangan, lokasi, atau olahraga...
                </div>
              </div>

              {/* Tab View 1: Beranda (Default) */}
              <div class="lk-body lk-tab-view" data-view-name="beranda">
                <div class="lk-section-title">Kategori Olahraga</div>
                <div class="lk-cat-row">
                  <span class="lk-cat-chip active" data-lk-cat="all" role="button" tabindex="0">Semua</span>
                  <span class="lk-cat-chip" data-lk-cat="futsal" role="button" tabindex="0">Futsal</span>
                  <span class="lk-cat-chip" data-lk-cat="soccer" role="button" tabindex="0">Mini Soccer</span>
                  <span class="lk-cat-chip" data-lk-cat="badminton" role="button" tabindex="0">Badminton</span>
                  <span class="lk-cat-chip" data-lk-cat="basket" role="button" tabindex="0">Basket</span>
                </div>

                <div class="lk-section-title">Rekomendasi Lapangan (Klik untuk pilih)</div>
                <div class="lk-field-grid">
                  {/* Field Card 1 (Futsal) */}
                  <div class="lk-field-card" data-field-cat="futsal" role="button" tabindex="0" title="Klik untuk simulasi booking slot">
                    <div class="lk-field-img futsal-bg">
                      <span class="lk-badge-cat">FUTSAL</span>
                      <span class="lk-badge-type">
                        <svg viewBox="0 0 24 24" width="5.5" height="5.5" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                        INDOOR
                      </span>
                    </div>
                    <div class="lk-field-info">
                      <div class="lk-venue-name">CHAMPIONS ARENA</div>
                      <div class="lk-court-name">Lapangan Futsal A</div>
                      <div class="lk-price-row">
                        <strong>Rp 120rb</strong><span>/ jam</span>
                      </div>
                      <div class="lk-meta-row">
                        <span class="lk-meta-item">
                          <svg viewBox="0 0 24 24" width="6" height="6" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="5" r="2"/><path d="m7 21 3-6 2 2v4"/><path d="m10 9 3 2 3-1"/><path d="m7 12 3-3"/></svg>
                          1.2 km
                        </span>
                        <span class="lk-meta-item">
                          <svg viewBox="0 0 24 24" width="6" height="6" fill="#F6AD55"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                          4.9
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* Field Card 2 (Mini Soccer) */}
                  <div class="lk-field-card" data-field-cat="soccer" role="button" tabindex="0" title="Klik untuk simulasi booking slot">
                    <div class="lk-field-img soccer-bg">
                      <span class="lk-badge-cat">MINI SOCCER</span>
                      <span class="lk-badge-type">
                        <svg viewBox="0 0 24 24" width="5.5" height="5.5" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
                        OUTDOOR
                      </span>
                    </div>
                    <div class="lk-field-info">
                      <div class="lk-venue-name">STADION GAJAYANA</div>
                      <div class="lk-court-name">Mini Soccer Utama</div>
                      <div class="lk-price-row">
                        <strong>Rp 350rb</strong><span>/ jam</span>
                      </div>
                      <div class="lk-meta-row">
                        <span class="lk-meta-item">
                          <svg viewBox="0 0 24 24" width="6" height="6" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="5" r="2"/><path d="m7 21 3-6 2 2v4"/><path d="m10 9 3 2 3-1"/><path d="m7 12 3-3"/></svg>
                          2.4 km
                        </span>
                        <span class="lk-meta-item">
                          <svg viewBox="0 0 24 24" width="6" height="6" fill="#F6AD55"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                          4.8
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* Field Card 3 (Badminton) */}
                  <div class="lk-field-card" data-field-cat="badminton" style="display: none;" role="button" tabindex="0" title="Klik untuk simulasi booking slot">
                    <div class="lk-field-img" style="background: #2563eb;">
                      <span class="lk-badge-cat">BADMINTON</span>
                      <span class="lk-badge-type">INDOOR</span>
                    </div>
                    <div class="lk-field-info">
                      <div class="lk-venue-name">SMASH ARENA</div>
                      <div class="lk-court-name">Lapangan Karpet A</div>
                      <div class="lk-price-row">
                        <strong>Rp 45rb</strong><span>/ jam</span>
                      </div>
                      <div class="lk-meta-row">
                        <span class="lk-meta-item">0.8 km</span>
                        <span class="lk-meta-item" style="color: #F6AD55;">★ 4.9</span>
                      </div>
                    </div>
                  </div>

                  {/* Field Card 4 (Basket) */}
                  <div class="lk-field-card" data-field-cat="basket" style="display: none;" role="button" tabindex="0" title="Klik untuk simulasi booking slot">
                    <div class="lk-field-img" style="background: #ea580c;">
                      <span class="lk-badge-cat">BASKET</span>
                      <span class="lk-badge-type">INDOOR</span>
                    </div>
                    <div class="lk-field-info">
                      <div class="lk-venue-name">DBL SPORT HALL</div>
                      <div class="lk-court-name">Main Court 01</div>
                      <div class="lk-price-row">
                        <strong>Rp 180rb</strong><span>/ jam</span>
                      </div>
                      <div class="lk-meta-row">
                        <span class="lk-meta-item">3.1 km</span>
                        <span class="lk-meta-item" style="color: #F6AD55;">★ 5.0</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* Tab View 2: Pesanan Aktif */}
              <div class="lk-body lk-tab-view" data-view-name="pesanan" style="display: none;">
                <div class="lk-section-title">Riwayat &amp; Pesanan Aktif</div>
                <div class="lk-order-card">
                  <div class="lk-order-head">
                    <span class="lk-order-code mono">LPK-20261028-09</span>
                    <span class="lk-order-status-badge">LUNAS • QRIS</span>
                  </div>
                  <div class="lk-order-venue">Champions Arena (Futsal A)</div>
                  <div class="lk-order-time mono">📅 Hari ini, 19:00 - 20:00 WIB</div>
                  <div class="lk-order-countdown">⏳ Sisa 2 jam sebelum kick-off</div>
                  <div class="lk-order-action">Tunjukkan QR Masuk Lapangan →</div>
                </div>
              </div>

              {/* Tab View 3: Favorit */}
              <div class="lk-body lk-tab-view" data-view-name="favorit" style="display: none;">
                <div class="lk-section-title">Lapangan Favorit Tersimpan</div>
                <div class="lk-fav-list">
                  <div class="lk-fav-item">
                    <span>★ Champions Arena (Futsal)</span>
                    <small>1.2 km • Rp 120rb/jam</small>
                  </div>
                  <div class="lk-fav-item">
                    <span>★ Stadion Gajayana (Mini Soccer)</span>
                    <small>2.4 km • Rp 350rb/jam</small>
                  </div>
                </div>
              </div>

              {/* Tab View 4: Profil */}
              <div class="lk-body lk-tab-view" data-view-name="profil" style="display: none;">
                <div class="lk-section-title">Akun Pengguna</div>
                <div class="lk-profile-card">
                  <div class="lk-profile-avatar">S</div>
                  <div>
                    <div class="lk-profile-name">Sobat Maulana</div>
                    <div class="lk-profile-tier mono">MEMBER GOLD TIER ✦</div>
                    <div class="lk-profile-stats">14 Pertandingan • 420 Poin Loyalty</div>
                  </div>
                </div>
              </div>

              {/* BottomNavigationBar (customer_main_page.dart — Material Icons) */}
              <div class="lk-bottom-nav">
                <div class="lk-nav-tab active" data-lk-tab="beranda" role="button" tabindex="0">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                  <b>Beranda</b>
                </div>
                <div class="lk-nav-tab" data-lk-tab="pesanan" role="button" tabindex="0">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/></svg>
                  <b>Pesanan</b>
                </div>
                <div class="lk-nav-tab" data-lk-tab="favorit" role="button" tabindex="0">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                  <b>Favorit</b>
                </div>
                <div class="lk-nav-tab" data-lk-tab="profil" role="button" tabindex="0">
                  <svg viewBox="0 0 24 24" width="8.5" height="8.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <b>Profil</b>
                </div>
              </div>
            </div>
          </div>

          {/* Bottom Home Indicator Bar */}
          <div class="phone-home-indicator" aria-hidden="true"></div>
        </div>
      </div>
    )}

    {/* 3. PBL-IVSS: Replika Akurat Halaman Utama (user/modul/index.php + user/style/navbar.css) */}
    {project.theme === 'lab' && (
      <div class="app-ivss" aria-label="Pratinjau halaman utama portal web Laboratorium IVSS Polinema">
        {/* Navbar (#0A192F + IVSS.png) */}
        <header class="ivss-navbar">
          <div class="ivss-logo-area">
            <img src="./projects/IVSS.png" alt="Logo IVSS" class="ivss-logo-img" loading="lazy" />
            <span class="ivss-site-title">IVSS</span>
          </div>
          <nav class="ivss-menu">
            <span class="active">Home</span>
            <span>About</span>
            <span>Research</span>
          </nav>
          <div class="ivss-mode-pills">
            <button type="button" class="ivss-mode-btn active" data-ivss-mode="portal">PORTAL</button>
            <button type="button" class="ivss-mode-btn" data-ivss-mode="cctv">LIVE CCTV AI</button>
          </div>
        </header>

        {/* Mode 1: Full Hero with real gedung.png background & exact overlay */}
        <div class="ivss-hero" style="background-image: linear-gradient(135deg, rgba(10, 35, 66, 0.84) 0%, rgba(0, 30, 60, 0.84) 50%, rgba(31, 66, 110, 0.84) 100%), url('./projects/gedung.png');">
          <div class="ivss-hero-content">
            <div class="ivss-h1">
              INTELLIGENT VISION<br/>AND SMART SYSTEM
            </div>
            <p class="ivss-tagline">
              Shaping the Future through Intelligent Vision and Adaptive Systems
            </p>
          </div>
          <div class="ivss-learn-more ivss-mode-btn" data-ivss-mode="cctv" role="button" tabindex="0">
            <svg viewBox="0 0 24 24" width="8" height="8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            Buka Live CCTV AI
          </div>
        </div>

        {/* Mode 2: Simulated Live CCTV AI Deep Learning Stream */}
        <div class="ivss-cctv-deck" style="display: none;">
          <div class="ivss-cctv-header mono">
            <div class="ivss-cam-tabs">
              <button type="button" class="ivss-cam-tab active" data-cam-id="1">CAM 01: GATEWAY DETECTION</button>
              <button type="button" class="ivss-cam-tab" data-cam-id="2">CAM 02: SERVER RACK TELEMETRY</button>
            </div>
            <span class="ivss-rec-badge"><span class="live-demo-pulse red"></span> REC ●</span>
          </div>

          <div class="ivss-cam-viewport">
            {/* Feed 1: Gateway */}
            <div class="ivss-cam-feed" data-feed-id="1">
              <div class="ivss-scanlines"></div>
              <div class="ivss-bbox box-person">
                <span class="ivss-bbox-tag mono">PERSON 98.4%</span>
              </div>
              <div class="ivss-bbox box-helmet">
                <span class="ivss-bbox-tag mono">HELMET: OK 94.2%</span>
              </div>
              <div class="ivss-feed-meta mono">
                <span>FPS: 30.1 | YOLOv8-IVSS</span>
                <span>RES: 1080p • INFERENCE: 16ms</span>
              </div>
            </div>

            {/* Feed 2: Server */}
            <div class="ivss-cam-feed" data-feed-id="2" style="display: none;">
              <div class="ivss-scanlines"></div>
              <div class="ivss-bbox box-server">
                <span class="ivss-bbox-tag mono">AI COMPUTE CLUSTER 01</span>
              </div>
              <div class="ivss-feed-meta mono">
                <span>GPU TEMP: 58°C | VRAM: 14.8 GB</span>
                <span>STATUS: INFERENCE ACTIVE</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* 4. CUCI.IN: Replika Akurat Halaman Utama (resources/views/welcome.blade.php — Heroicons SVG) */}
    {project.theme === 'pos' && (
      <div class="app-cuciin" aria-label="Pratinjau halaman utama CUCI.IN Laundry Management & Tracking">
        {/* Sticky White Navbar (welcome.blade.php) */}
        <header class="ci-navbar">
          <div class="ci-brand">
            {/* Official Washing Machine Squircle SVG from app-logo.blade.php */}
            <svg class="ci-logo-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="6" width="88" height="88" rx="24" fill="#0e7490" />

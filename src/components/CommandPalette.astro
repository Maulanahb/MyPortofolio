---
// Command Palette Dialog (Ctrl + K / Cmd + K)
---
<div class="overlay" id="command-overlay" role="presentation">
  <div class="dialog command-dialog" role="dialog" aria-modal="true" aria-label="Navigasi cepat">
    <input class="command-input mono" id="command-search" type="text" placeholder="Cari bagian atau aksi..." autocomplete="off" aria-label="Cari perintah" />
    <div class="command-list" id="command-results"></div>
    <div class="command-help mono">Enter untuk memilih perintah pertama · Esc untuk menutup</div>
  </div>
</div>


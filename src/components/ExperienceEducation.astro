---
import { EXPERIENCES, EDUCATION_INFO, CERTIFICATIONS } from '../data/projects';
---

<!-- 5. PENGALAMAN & ORGANISASI -->
<section class="section shell" id="pengalaman" aria-labelledby="exp-title">
  <div class="chapter-kicker mono">✦ CHAPTER 03 <span>PENGALAMAN &amp; KERJA TIM</span></div>
  <div class="section-head">
    <div>
      <div class="eyebrow mono">✦ REKAM JEJAK &amp; KERJA TIM</div>
      <h2 class="section-title display" id="exp-title">PENGALAMAN PROYEK<br/><span class="title-highlight">&amp; KOLABORASI TIM.</span></h2>
    </div>
  </div>

  <div class="exp-grid">
    {EXPERIENCES.map((exp, idx) => (
      <article class="exp-card comic-panel">
        <div class="exp-card-head">
          <span class="exp-period mono">{exp.period}</span>
          <span class="exp-type-badge mono">{exp.type}</span>
        </div>

        <h3 class="exp-role display">{exp.role}</h3>
        <div class="exp-org mono">{exp.organization}</div>
        <p class="exp-summary">{exp.summary}</p>

        <div class="exp-contrib-wrap">
          <div class="exp-contrib-label mono">TANGGUNG JAWAB &amp; KONTRIBUSI:</div>
          <ul class="exp-contrib-list">
            {exp.contributions.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <span class="exp-index-watermark display" aria-hidden="true">0{idx + 1}</span>
      </article>
    ))}
  </div>
</section>

<hr class="section-rule" />

<!-- 6. PENDIDIKAN DAN CAPAIAN -->
<section class="section shell" id="pendidikan" aria-labelledby="edu-title">
  <div class="chapter-kicker mono">✦ CHAPTER 04 <span>PENDIDIKAN &amp; CAPAIAN</span></div>
  <div class="section-head">
    <div>
      <div class="eyebrow mono">✦ LATAR AKADEMIK &amp; PRESTASI</div>
      <h2 class="section-title display" id="edu-title">RIWAYAT PENDIDIKAN<br/><span class="title-highlight">&amp; PENCAPAIAN.</span></h2>
    </div>
  </div>

  <div class="edu-credentials-grid">
    <!-- Kartu Utama Pendidikan -->
    <article class="edu-main-card comic-panel">
      <div class="edu-card-kicker mono">PENDIDIKAN TINGGI VOKASI</div>
      <h3 class="edu-campus display">{EDUCATION_INFO.campus}</h3>
      <div class="edu-program-row">
        <strong class="edu-program">{EDUCATION_INFO.program}</strong>
        <span class="edu-faculty mono">{EDUCATION_INFO.faculty} · NIM {EDUCATION_INFO.nim}</span>
      </div>

      <div class="edu-stats-strip">
        <div class="edu-stat-box">
          <span class="mono">PERIODE STUDI</span>
          <strong>{EDUCATION_INFO.period}</strong>
        </div>
        <div class="edu-stat-box">
          <span class="mono">STATUS SAAT INI</span>
          <strong>{EDUCATION_INFO.semester}</strong>
        </div>
        <div class="edu-stat-box highlight">
          <span class="mono">KETERSEDIAAN</span>
          <strong>Siap Magang / PKL</strong>
        </div>
        <div class="edu-stat-box">
          <span class="mono">REPOSITORI PUBLIK</span>
          <strong>{EDUCATION_INFO.repoMetric}</strong>
        </div>
      </div>

      <p class="edu-summary">{EDUCATION_INFO.summary}</p>
    </article>

    <!-- Kolom Kanan: Sertifikasi Resmi -->
    <div class="edu-side-stack">
      <article class="cred-box comic-panel">
        <div class="cred-box-head">
          <span class="cred-tag pop mono">SERTIFIKASI RESMI</span>
          <h3 class="display">SERTIFIKAT KOMPETENSI</h3>
        </div>
        <ul class="cred-list">
          {CERTIFICATIONS.map(cert => (
            <li class="cred-item">
              <div class="cred-item-top">
                <span class="ach-badge mono">{cert.issuer} · {cert.year}</span>
                <strong class="cred-name">{cert.name}</strong>
              </div>
              <p class="cred-focus">{cert.focus}</p>
              {cert.credentialUrl && (
                <div class="cred-link-wrap">
                  <a
                    class="cert-link mono"
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>Verifikasi Sertifikat</span>
                    <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7m0 0H8m9 0v9"/></svg>
                  </a>
                </div>
              )}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

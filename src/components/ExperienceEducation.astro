---
import { EXPERIENCES, EDUCATION_INFO, CERTIFICATIONS, ACHIEVEMENTS } from '../data/projects';
---

<!-- 5. PENGALAMAN & ORGANISASI -->
<section class="section shell" id="pengalaman" aria-labelledby="exp-title">
  <div class="chapter-kicker mono">✦ CHAPTER 03 <span>PENGALAMAN, RISET LAB &amp; ORGANISASI TIM</span></div>
  <div class="section-head">
    <div>
      <div class="eyebrow mono">04 / Pengalaman &amp; kontribusi nyata</div>
      <h2 class="section-title display" id="exp-title">BUKAN SEKADAR JABATAN.<br/><span class="title-highlight">FOKUS PADA KONTRIBUSI &amp; HASIL.</span></h2>
    </div>
    <p class="section-aside">
      Rangkaian pengalaman dalam proyek laboratorium kampus (PBL), pengembangan sistem operasional UMKM, kompetisi produk AI, serta kolaborasi tim akademik.
    </p>
  </div>

  <div class="exp-grid">
    {EXPERIENCES.map((exp, idx) => (
      <article class="exp-card comic-panel">
        <div class="exp-card-head">
          <span class="exp-period mono">{exp.period}</span>
          <span class="exp-type-badge mono">{exp.type}</span>
        </div>

        <h3 class="exp-role display">{exp.role}</h3>
        <div class="exp-org mono">{exp.organization}</div>
        <p class="exp-summary">{exp.summary}</p>

        <div class="exp-contrib-wrap">
          <div class="exp-contrib-label mono">KONTRIBUSI SPESIFIK:</div>
          <ul class="exp-contrib-list">
            {exp.contributions.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div class="exp-result-banner mono">
          <span class="exp-result-dot"></span>
          <span>{exp.resultHighlight}</span>
        </div>
        <span class="exp-index-watermark display" aria-hidden="true">0{idx + 1}</span>
      </article>
    ))}
  </div>
</section>

<hr class="section-rule" />

<!-- 6. PENDIDIKAN, SERTIFIKASI, DAN PRESTASI -->
<section class="section shell" id="pendidikan" aria-labelledby="edu-title">
  <div class="chapter-kicker mono">✦ CHAPTER 04 <span>PENDIDIKAN, SERTIFIKASI &amp; PRESTASI</span></div>
  <div class="section-head">
    <div>
      <div class="eyebrow mono">05 / Latar akademik &amp; kredensial</div>
      <h2 class="section-title display" id="edu-title">FONDASI AKADEMIK<br/><span class="title-highlight">&amp; REKAM JEJAK.</span></h2>
    </div>
  </div>

  <div class="edu-credentials-grid">
    <!-- Kartu Utama Pendidikan -->
    <article class="edu-main-card comic-panel">
      <div class="edu-card-kicker mono">PENDIDIKAN TINGGI VOKASI</div>
      <h3 class="edu-campus display">{EDUCATION_INFO.campus}</h3>
      <div class="edu-program-row">
        <strong class="edu-program">{EDUCATION_INFO.program}</strong>
        <span class="edu-faculty mono">{EDUCATION_INFO.faculty}</span>
      </div>

      <div class="edu-stats-strip">
        <div class="edu-stat-box">
          <span class="mono">PERIODE STUDI</span>
          <strong>{EDUCATION_INFO.period}</strong>
        </div>
        <div class="edu-stat-box">
          <span class="mono">STATUS SAAT INI</span>
          <strong>{EDUCATION_INFO.semester}</strong>
        </div>
        <div class="edu-stat-box highlight">
          <span class="mono">INDEKS PRESTASI (IPK)</span>
          <strong>{EDUCATION_INFO.gpa}</strong>
        </div>
      </div>

      <p class="edu-summary">{EDUCATION_INFO.summary}</p>

      <div class="edu-coursework">
        <div class="coursework-title mono">FOKUS KOMPETENSI &amp; MATA KULIAH RELEVAN:</div>
        <div class="coursework-pills">
          {EDUCATION_INFO.coursework.map(course => (
            <span class="course-pill mono">{course}</span>
          ))}
        </div>
      </div>
    </article>

    <!-- Kolom Kanan: Sertifikasi & Prestasi/Kompetisi -->
    <div class="edu-side-stack">
      <!-- Blok Sertifikasi & Pelatihan -->
      <article class="cred-box comic-panel">
        <div class="cred-box-head">
          <span class="cred-tag mono">SERTIFIKASI &amp; PELATIHAN</span>
          <h3 class="display">KURSUS &amp; KOMPETENSI</h3>
        </div>
        <ul class="cred-list">
          {CERTIFICATIONS.map(cert => (
            <li class="cred-item">
              <div class="cred-item-top">
                <strong class="cred-name">{cert.name}</strong>
                <span class="cred-meta mono">{cert.issuer} · {cert.year}</span>
              </div>
              <p class="cred-focus">{cert.focus}</p>
              {cert.credentialUrl && (
                <a
                  class="cert-link mono"
                  href={cert.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >Lihat Kredensial ↗</a>
              )}
            </li>
          ))}
        </ul>
      </article>

      <!-- Blok Prestasi, Lomba & Karya Unggulan -->
      <article class="cred-box comic-panel">
        <div class="cred-box-head">
          <span class="cred-tag pop mono">PRESTASI, KOMPETISI &amp; RISET</span>
          <h3 class="display">CAPAIAN &amp; PENGAKUAN</h3>
        </div>
        <ul class="cred-list">
          {ACHIEVEMENTS.map(ach => (
            <li class="cred-item">
              <div class="cred-item-top">
                <span class="ach-badge mono">{ach.badge} · {ach.year}</span>
                <strong class="cred-name">{ach.title}</strong>
                <span class="cred-meta mono">{ach.organizer}</span>
              </div>
              <p class="cred-focus">{ach.description}</p>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

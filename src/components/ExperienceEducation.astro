---
import { EXPERIENCES, EDUCATION_INFO, CERTIFICATIONS } from '../data/projects';
---

<div class="bg-contour-stage">
<!-- PENGALAMAN PROYEK -->
<section class="section" id="pengalaman" aria-labelledby="exp-title">
  <div class="shell">
    <div class="section-head">
    <div>
      <h2 class="section-title display" id="exp-title">Pengalaman <span class="title-highlight rb-gradient-text">Proyek</span></h2>
      <p class="section-subtitle">Keterlibatan saya di analisis sistem, pengembangan web, dan aplikasi mobile bersama tim maupun secara mandiri.</p>
    </div>
  </div>

  <div class="exp-grid" data-spotlight>
    {EXPERIENCES.map((exp, idx) => (
      <article class="exp-card" data-animated-list data-timeline-node style={`--rb-list-i: ${idx};`}>
        <div class="exp-timeline-meta">
          <span class="exp-period mono" data-decrypt>{exp.period}</span>
          <span class="exp-type-badge mono">{exp.type}</span>
        </div>
        <div class="exp-timeline-body">
          <h3 class="exp-role display">{exp.role}</h3>
          <div class="exp-org mono">{exp.organization}</div>
          <p class="exp-summary">{exp.summary}</p>

          <div class="exp-contrib-wrap">
            <div class="exp-contrib-label mono">Kontribusi</div>
            <ul class="exp-contrib-list">
              {exp.contributions.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </div>
  </div>
</section>

<hr class="section-rule" />

<!-- PENDIDIKAN DAN SERTIFIKASI -->
<section class="section" id="pendidikan" aria-labelledby="edu-title">
  <div class="shell">
    <div class="section-head">
    <div>
      <h2 class="section-title display" id="edu-title">Pendidikan <span class="title-highlight rb-gradient-text">&amp; Sertifikasi</span></h2>
      <p class="section-subtitle">Pendidikan vokasi yang sedang ditempuh beserta sertifikasi pendukung selama masa kuliah.</p>
    </div>
  </div>

  <div class="edu-credentials-grid" data-spotlight>
    <!-- Open education record -->
    <article class="edu-main-card" data-reveal>
      <h3 class="edu-campus display">{EDUCATION_INFO.campus}</h3>
      <div class="edu-program-row">
        <strong class="edu-program">{EDUCATION_INFO.program}</strong>
        <span class="edu-faculty mono">{EDUCATION_INFO.faculty} · NIM {EDUCATION_INFO.nim}</span>
      </div>

      <div class="edu-stats-strip">
        <div class="edu-stat-box">
          <span class="mono" data-decrypt>Periode</span>
          <strong data-countup-start="2020" data-countup-target="2024" data-countup-suffix=" – Sekarang">{EDUCATION_INFO.period}</strong>
        </div>
        <div class="edu-stat-box">
          <span class="mono" data-decrypt>Semester</span>
          <strong data-countup-start="1" data-countup-target="5" data-countup-prefix="Semester ">{EDUCATION_INFO.semester}</strong>
        </div>
        <div class="edu-stat-box highlight">
          <span class="mono" data-decrypt>Status</span>
          <strong class="status-inline"><span class="status-dot" aria-hidden="true"></span>{EDUCATION_INFO.status}</strong>
        </div>
      </div>

      <p class="edu-summary">{EDUCATION_INFO.summary}</p>
    </article>

    <!-- Kolom Kanan: Sertifikasi -->
    <div class="edu-side-stack">
      <article class="cred-box" data-reveal>
        <div class="cred-box-head">
          <h3 class="display">Sertifikasi</h3>
        </div>
        <ul class="cred-list">
          {CERTIFICATIONS.map((cert, idx) => (
            <li class="cred-item" data-flowing-row data-animated-list data-timeline-node style={`--rb-list-i: ${idx};`}>
              <div class="cred-item-top">
                <strong class="cred-name">{cert.name}</strong>
                <span class="ach-badge mono">{cert.issuer} · {cert.year}</span>
              </div>
              <p class="cred-focus">{cert.focus}</p>
              {cert.credentialUrl && (
                <div class="cred-link-wrap">
                  <a
                    class="cert-link mono"
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>Verifikasi Sertifikat</span>
                    <svg class="ledger-arrow" aria-hidden="true" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17L17 7m0 0H8m9 0v9"/></svg>
                  </a>
                </div>
              )}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
  </div>
</section>
</div>
